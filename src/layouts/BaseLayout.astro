---
import '../styles/archive.css';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title ? `${title} · c0ns1d2` : 'c0ns1d2 · 惊天魔盗团记忆库'}</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%231d1d1b'/></svg>">
  <style is:global>
    body { font-family: var(--font); background: var(--archive-bg); color: var(--archive-ink); min-height: 100vh; }
    a { color: inherit; text-decoration: none; }
    h1, h2 { font-family: var(--archive-serif); }
    :focus-visible { outline: 2px solid var(--archive-ink); outline-offset: 5px; }
    .nav { position: fixed; inset: 0 0 auto; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 40px; background: var(--archive-bg); border-bottom: 1px solid var(--archive-line); }
    .nav-logo { font-size: 1.1rem; font-weight: 500; letter-spacing: 2px; color: var(--archive-ink); }
    .nav-links { display: flex; align-items: center; gap: 30px; }
    .nav-links a { font-size: .88rem; color: var(--archive-muted); }
    .nav-links a:hover, .nav-links a[aria-current="page"] { color: var(--archive-ink); }
    .content { padding-top: var(--site-nav-height, 76px); min-height: 100vh; }
    .footer { text-align: center; padding: 36px 20px; color: var(--archive-muted); font-size: .75rem; border-top: 1px solid var(--archive-line); }
    @media(max-width: 600px) { .nav { padding: 12px 16px; gap: 12px; } .nav-logo { font-size: .95rem; } .nav-links { gap: 17px; } .nav-links a { font-size: .8rem; } }
  </style>
</head>
<body>
  <nav class="nav" id="siteNav" aria-label="主导航">
    <a href="/" class="nav-logo">c0ns1d2</a>
    <div class="nav-links">
      <a href="/topics">专题</a>
      <!--archive:account:start--><!--archive:account:end-->
    </div>
  </nav>
  <main class="content"><slot /></main>
  <footer class="footer">c0ns1d2 · 惊天魔盗团记忆库 · 2026</footer>
  <script>
    const navigation = document.getElementById('siteNav');
    if (navigation) {
      const updateHeight = () => document.documentElement.style.setProperty('--site-nav-height', navigation.getBoundingClientRect().height + 'px');
      new ResizeObserver(updateHeight).observe(navigation); updateHeight();
      navigation.querySelectorAll<HTMLAnchorElement>('a').forEach(link => {
        const path = link.getAttribute('href');
        if (path && (path === '/' ? location.pathname === '/' : location.pathname === path || location.pathname.startsWith(path + '/') || path.endsWith('/topics') && /^\/(?:guest\/)?(?:events|works|thoughts)(?:\/|$)/.test(location.pathname))) link.setAttribute('aria-current', 'page');
      });
    }
  </script>
</body>
</html>
