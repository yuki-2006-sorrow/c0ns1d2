---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);
const people = await getCollection('people');
const journals = await getCollection('journal', ({ data }) => !data.draft);

const searchData = {
  events: events.map(e => ({
    slug: e.slug,
    title: e.data.title,
    date: e.data.date,
    persons: e.data.persons,
    tags: e.data.tags,
    body: e.body,
    type: '事件',
  })),
  people: people.map(p => ({
    slug: p.slug,
    title: p.data.name,
    nickname: p.data.nickname,
    role: p.data.role,
    body: p.body,
    type: '人物',
  })),
  journals: journals.map(j => ({
    slug: j.slug,
    title: j.data.title,
    date: j.data.date,
    author: j.data.author,
    tags: j.data.tags,
    body: j.body,
    type: '随笔',
  })),
};
---

<BaseLayout title="搜索">
  <div style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="font-size: 2em; margin-bottom: 30px; color: #fff;">搜索</h1>

    <div style="position: relative; margin-bottom: 30px;">
      <input
        id="search-input"
        type="text"
        placeholder="搜索事件、人物、随笔..."
        style="width: 100%; padding: 16px 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: #fff; font-size: 1.05em; outline: none; transition: border-color 0.3s;"
      >
    </div>

    <div id="search-results" style="display: flex; flex-direction: column; gap: 10px;">
      <div style="color: rgba(255,255,255,0.3); text-align: center; padding: 40px;">输入关键词开始搜索</div>
    </div>
  </div>

  <script type="application/json" id="search-data">{JSON.stringify(searchData)}</script>

  <script is:inline>
    const searchData = JSON.parse(document.getElementById('search-data').textContent);
    const allItems = [
      ...searchData.events.map(e => ({ ...e, url: '/events/' + e.slug })),
      ...searchData.people.map(p => ({ ...p, url: '/people/' + p.slug })),
      ...searchData.journals.map(j => ({ ...j, url: '/journal/' + j.slug })),
    ];

    const input = document.getElementById('search-input');
    const resultsDiv = document.getElementById('search-results');

    function highlight(text, keyword) {
      if (!keyword) return text;
      const regex = new RegExp('(' + keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      return text.replace(regex, '<mark style="background: rgba(76,161,175,0.3); color: #4ca1af; padding: 0 2px; border-radius: 3px;">$1</mark>');
    }

    function search(keyword) {
      if (!keyword.trim()) {
        resultsDiv.innerHTML = '<div style="color: rgba(255,255,255,0.3); text-align: center; padding: 40px;">输入关键词开始搜索</div>';
        return;
      }
      const kw = keyword.toLowerCase();
      const results = allItems.filter(item => {
        const searchText = (item.title + ' ' + (item.body || '') + ' ' + (item.persons || []).join(' ') + ' ' + (item.tags || []).join(' ') + ' ' + (item.nickname || '') + ' ' + (item.role || '')).toLowerCase();
        return searchText.includes(kw);
      });

      if (results.length === 0) {
        resultsDiv.innerHTML = '<div style="color: rgba(255,255,255,0.3); text-align: center; padding: 40px;">没有找到相关结果</div>';
        return;
      }

      resultsDiv.innerHTML = results.map(item => {
        const snippet = (item.body || '').replace(/<[^>]*>/g, '').substring(0, 120);
        return `
          <a href="${item.url}" style="display: block; padding: 18px 20px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; transition: all 0.3s;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
              <span style="background: rgba(76,161,175,0.15); color: #4ca1af; padding: 2px 8px; border-radius: 8px; font-size: 0.75em;">${item.type}</span>
              <span style="color: #fff; font-size: 1.05em;">${highlight(item.title, keyword)}</span>
            </div>
            ${item.date ? `<div style="color: rgba(255,255,255,0.4); font-size: 0.85em; margin-bottom: 6px;">${item.date}</div>` : ''}
            ${snippet ? `<div style="color: rgba(255,255,255,0.5); font-size: 0.9em; line-height: 1.6;">${highlight(snippet, keyword)}...</div>` : ''}
          </a>
        `;
      }).join('');
    }

    input.addEventListener('input', (e) => search(e.target.value));
    input.focus();
  </script>
  <style is:global>
    #search-input:focus { border-color: #4ca1af !important; }
    #search-results a:hover { background: rgba(255,255,255,0.06) !important; border-color: rgba(76,161,175,0.3) !important; }
  </style>
</BaseLayout>
