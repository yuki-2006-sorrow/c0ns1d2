---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const people = await getCollection('people');
  const events = await getCollection('events', ({ data }) => !data.draft);
  return people.map(person => ({
    params: { slug: person.slug },
    props: { person, allEvents: events },
  }));
}

const { person, allEvents } = Astro.props;
const { Content } = await render(person);

const traits = [
  { key: 'openness', label: '开放性' },
  { key: 'conscientiousness', label: '尽责性' },
  { key: 'extraversion', label: '外向性' },
  { key: 'agreeableness', label: '宜人性' },
  { key: 'neuroticism', label: '神经质' },
];

// 筛选该人物参与的事件
const personEvents = allEvents
  .filter(e => e.data.persons.includes(person.data.name))
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title={person.data.name}>
  <article style="max-width: 750px; margin: 0 auto; padding: 40px 20px 80px;">
    <div style="display: flex; align-items: center; gap: 25px; margin-bottom: 40px;">
      <div style="width: 80px; height: 80px; border-radius: 50%; background: {person.data.color}; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2em; font-weight: 600; flex-shrink: 0;">
        {person.data.name[0]}
      </div>
      <div>
        <h1 style="font-size: 2em; color: #fff; margin-bottom: 6px;">{person.data.name}</h1>
        <div style="color: rgba(255,255,255,0.5); font-size: 0.95em;">{person.data.nickname} · {person.data.role}</div>
        <div style="color: rgba(255,255,255,0.4); font-size: 0.85em; margin-top: 4px;">{person.data.university} · {person.data.major}</div>
      </div>
    </div>

    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 25px; margin-bottom: 40px;">
      <h3 style="color: #fff; font-size: 1.1em; margin-bottom: 20px;">大五人格画像</h3>
      {traits.map(trait => (
        <div style="margin-bottom: 14px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span style="color: rgba(255,255,255,0.7); font-size: 0.9em;">{trait.label}</span>
            <span style="color: {person.data.color}; font-size: 0.9em;">{person.data.personality[trait.key]}%</span>
          </div>
          <div style="height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
            <div style="height: 100%; width: {person.data.personality[trait.key]}%; background: {person.data.color}; border-radius: 3px;"></div>
          </div>
        </div>
      ))}
    </div>

    {person.data.tags.length > 0 && (
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 35px;">
        {person.data.tags.map(tag => (
          <span style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.6); padding: 4px 12px; border-radius: 12px; font-size: 0.8em;">#{tag}</span>
        ))}
      </div>
    )}

    <div class="person-content">
      <Content />
    </div>

    {personEvents.length > 0 && (
      <div style="margin-top: 50px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1);">
        <h2 style="color: #fff; font-size: 1.3em; margin-bottom: 20px;">参与的事件 ({personEvents.length})</h2>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          {personEvents.map(e => (
            <a href={`/events/${e.slug.split('/').pop()}`} style="display: flex; align-items: center; gap: 15px; padding: 14px 18px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; transition: all 0.3s;">
              <div style="width: 10px; height: 10px; border-radius: 50%; background: {e.data.color}; flex-shrink: 0;"></div>
              <div style="flex: 1;">
                <div style="color: #fff; font-size: 0.98em;">{e.data.title}</div>
                <div style="color: rgba(255,255,255,0.4); font-size: 0.8em;">{e.data.date}</div>
              </div>
              <div style="color: rgba(255,255,255,0.3);">→</div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div style="margin-top: 50px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1);">
      <a href="/people" style="color: #4ca1af; font-size: 0.9em;">← 返回全部人物</a>
    </div>
  </article>

  <style is:global>
    .person-content { color: rgba(255,255,255,0.8); line-height: 2; font-size: 1.02em; }
    .person-content p { margin-bottom: 18px; }
    a[href^="/events/"]:hover { background: rgba(255,255,255,0.06) !important; border-color: rgba(76,161,175,0.3) !important; }
  </style>
</BaseLayout>
