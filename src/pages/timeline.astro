---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { contentPreview } from '../lib/content-preview.mjs';
import { prepareTimeline } from '../lib/timeline-model.mjs';
import '../styles/timeline.css';

const events = (await getCollection('events', ({ data }) => !data.draft)).map(event => ({
  slug: event.slug.split('/').pop(),
  title: event.data.title,
  date: event.data.date,
  major: event.data.major,
  medium: event.data.medium,
  summary: contentPreview(event.data.summary, event.body, 170),
  image: event.data.images[0] || '',
}));
const folders = Object.fromEntries((await getCollection('mediums', ({ data }) => !data.draft))
  .map(folder => [folder.id.replace(/\.md$/, ''), { title: folder.data.title, parent: folder.data.parent || '' }]));
const model = prepareTimeline(events, folders);
---

<BaseLayout title="时间与记忆">
  <section class="timeline" id="tl" aria-labelledby="timeline-title">
    <header class="tl-header">
      <div>
        <p class="archive-eyebrow">沿着时间，慢慢想起</p>
        <h1 id="timeline-title">时间与记忆<span aria-hidden="true"> / </span></h1>
        <p class="tl-description">有些事连成一段，有些事只留下一个瞬间。</p>
      </div>
      <nav class="memory-views" aria-label="记忆浏览方式">
        <a href="/events">列表</a><a href="/timeline" aria-current="page">绳子时间线</a>
      </nav>
    </header>

    <div class="tl-controls" hidden>
      <nav id="tl-years" class="tl-years" aria-label="选择年份">
        <button type="button" data-year="all" aria-pressed="true">全部</button>
        {model.years.map(year => <button type="button" data-year={year} aria-pressed="false">{year === 'undated' ? '日期未定' : year}</button>)}
      </nav>
      {model.groups.length > 0 && <label class="tl-group-label">分组
        <select id="tl-group"><option value="">全部记忆</option>{model.groups.map(group => <option value={group.id}>{group.title}（{group.count}）</option>)}</select>
      </label>}
    </div>

    <div class="tl-caption">
      <p id="tl-info" role="status" aria-live="polite">{model.entries.length} 段记忆</p>
      <p class="tl-legend"><span>日期挂绳</span><span>事件串绳</span></p>
      <div class="tl-paging" hidden>
        <button id="tl-prev" type="button" aria-label="往前翻阅">←</button>
        <button id="tl-latest" type="button">最近一件</button>
        <button id="tl-next" type="button" aria-label="往后翻阅">→</button>
      </div>
    </div>
    <div id="tl-scroll" class="tl-scroll" role="region" aria-label="挂绳记忆，左右方向键翻阅" tabindex="0">
      <div id="tl-sheet" class="tl-sheet">
        <svg id="tl-cords" class="tl-cords" aria-hidden="true"></svg>
        <ol id="tl-list" class="tl-list">
          {model.entries.map((event, index) => <li class="tl-item" data-event={event.slug}>
            <div class="tl-date">{event.time.label}</div>
            <a class:list={['tl-card', { 'tl-card-major': event.major, 'tl-card-photo': !!event.image }]}
              href={'/events/' + encodeURIComponent(event.slug)} aria-labelledby={'title-' + index} aria-describedby={'date-' + index}>
              <span class="tl-pin" aria-hidden="true"></span>
              {event.image && <div class="tl-photo"><img src={event.image} alt="" loading="lazy" decoding="async" /><span class="tl-photo-fallback">照片暂时未能载入</span></div>}
              <div class="tl-card-text">
                <div class="tl-card-meta"><span>{event.major ? '重要记忆' : event.trail.at(-1)?.title || '记忆片段'}</span><span class="tl-number" aria-hidden="true">{String(index + 1).padStart(3, '0')}</span></div>
                <h2 id={'title-' + index}>{event.title}</h2>
                {event.summary && <p class="tl-summary">{event.summary}</p>}
                <span id={'date-' + index} class="tl-sr-only">{event.time.label}</span>
                <span class="tl-enter">打开这段记忆 <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          </li>)}
        </ol>
      </div>
      <p class="tl-empty" id="tl-empty" hidden={model.entries.length > 0}>这一段还没有公开的记忆。<button id="tl-reset" type="button" hidden>查看全部记忆</button></p>
    </div>

    <div class="tl-bottom">
      <p class="tl-note"><span class="tl-desktop-hint">横向滚动，或用箭头翻阅。 </span>实线按时间串联，虚线不区分先后。间隔为阅读留白。</p>
    </div>
    <noscript><p class="tl-note">当前显示全部公开记忆。启用 JavaScript 后可按年份和分组翻阅。</p></noscript>
  </section>
  <script id="timeline-data" type="application/json" set:html={JSON.stringify({
    entries: model.entries.map(({ slug, time, trail }) => ({ slug, time, trail })),
    years: model.years, groups: model.groups.map(group => group.id),
  }).replace(/</g, '\\u003c')} />
  <script>import '../scripts/timeline.js';</script>
</BaseLayout>
