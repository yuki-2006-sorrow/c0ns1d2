---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);
const people = await getCollection('people');

// 事件类型分布
const categoryCount = { core: 0, food: 0, exam: 0, other: 0 };
const categoryNames = { core: '核心事件', food: '聚餐/生日', exam: '高考相关', other: '日常/其他' };
const categoryColors = { core: '#4ca1af', food: '#e74c3c', exam: '#f39c12', other: '#9b59b6' };
events.forEach(e => categoryCount[e.data.category]++);

// 人物参与事件数
const personCount = {};
people.forEach(p => personCount[p.data.name] = 0);
events.forEach(e => e.data.persons.forEach(p => { if (personCount[p] !== undefined) personCount[p]++; }));
const sortedPeople = Object.entries(personCount).sort((a, b) => b[1] - a[1]);
const maxPersonCount = Math.max(1, ...sortedPeople.map(p => p[1]));

// 事件按月分布
const monthCount = {};
events.forEach(e => {
  if (!/^\d{4}-\d{2}/.test(e.data.date)) return;
  const month = e.data.date.substring(0, 7);
  monthCount[month] = (monthCount[month] || 0) + 1;
});
const sortedMonths = Object.entries(monthCount).sort((a, b) => a[0].localeCompare(b[0]));
const maxMonthCount = Math.max(1, ...sortedMonths.map(m => m[1]));
const monthNumber = value => Number(value.slice(0, 4)) * 12 + Number(value.slice(5, 7));
const monthSpan = sortedMonths.length ? monthNumber(sortedMonths[sortedMonths.length - 1][0]) - monthNumber(sortedMonths[0][0]) + 1 : 0;

// 标签分布
const tagCount = {};
events.forEach(e => e.data.tags.forEach(t => tagCount[t] = (tagCount[t] || 0) + 1));
const sortedTags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]);

// 计算环形图
const totalEvents = events.length;
let cumulativePercent = 0;
const categorySegments = Object.entries(categoryCount).map(([cat, count]) => {
  const percent = count / (totalEvents || 1);
  const startAngle = cumulativePercent * 360;
  cumulativePercent += percent;
  const endAngle = cumulativePercent * 360;
  return { cat, count, percent, startAngle, endAngle, color: categoryColors[cat] };
});

function polarToCartesian(cx, cy, r, angle) {
  const rad = (angle - 90) * Math.PI / 180;
  return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
}
function describeArc(cx, cy, r, startAngle, endAngle) {
  if (endAngle - startAngle >= 359.99) return `M ${cx} ${cy - r} A ${r} ${r} 0 1 1 ${cx} ${cy + r} A ${r} ${r} 0 1 1 ${cx} ${cy - r}`;
  const start = polarToCartesian(cx, cy, r, endAngle);
  const end = polarToCartesian(cx, cy, r, startAngle);
  const largeArcFlag = endAngle - startAngle <= 180 ? '0' : '1';
  return `M ${start.x} ${start.y} A ${r} ${r} 0 ${largeArcFlag} 0 ${end.x} ${end.y}`;
}
---

<BaseLayout title="统计">
  <div style="max-width: 1000px; margin: 0 auto; padding: 40px 20px 80px;">
    <h1 style="font-size: 2em; margin-bottom: 10px; color: #fff;">数据统计</h1>
    <p style="color: rgba(255,255,255,0.5); margin-bottom: 50px;">从数据看这群人的一年</p>

    <!-- 概览卡片 -->
    <div class="stats-overview" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 50px;">
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 25px; text-align: center;">
        <div style="color: #4ca1af; font-size: 2.2em; font-weight: 600;">{totalEvents}</div>
        <div style="color: rgba(255,255,255,0.5); font-size: 0.9em; margin-top: 5px;">事件总数</div>
      </div>
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 25px; text-align: center;">
        <div style="color: #e74c3c; font-size: 2.2em; font-weight: 600;">{people.length}</div>
        <div style="color: rgba(255,255,255,0.5); font-size: 0.9em; margin-top: 5px;">成员</div>
      </div>
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 25px; text-align: center;">
        <div style="color: #f39c12; font-size: 2.2em; font-weight: 600;">{sortedTags.length}</div>
        <div style="color: rgba(255,255,255,0.5); font-size: 0.9em; margin-top: 5px;">分类标签</div>
      </div>
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 25px; text-align: center;">
        <div style="color: #9b59b6; font-size: 2.2em; font-weight: 600;">{monthSpan}</div>
        <div style="color: rgba(255,255,255,0.5); font-size: 0.9em; margin-top: 5px;">月份跨度</div>
      </div>
    </div>

    <div class="stats-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 50px;">
      <!-- 事件类型分布 -->
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 30px;">
        <h2 style="color: #fff; font-size: 1.2em; margin-bottom: 25px;">事件类型分布</h2>
        <div style="display: flex; align-items: center; gap: 30px;">
          <svg width="160" height="160" viewBox="0 0 160 160">
            {categorySegments.filter(s => s.count > 0).map(s => (
              <path d={describeArc(80, 80, 65, s.startAngle, s.endAngle)} fill="none" stroke={s.color} stroke-width="25" />
            ))}
            <text x="80" y="75" text-anchor="middle" fill="#fff" font-size="24" font-weight="600">{totalEvents}</text>
            <text x="80" y="95" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-size="12">事件</text>
          </svg>
          <div style="flex: 1;">
            {Object.entries(categoryCount).map(([cat, count]) => (
              <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                <div style={`width: 12px; height: 12px; border-radius: 3px; background: ${categoryColors[cat]};`}></div>
                <span style="color: rgba(255,255,255,0.7); font-size: 0.9em; flex: 1;">{categoryNames[cat]}</span>
                <span style="color: #fff; font-size: 0.9em; font-weight: 600;">{count}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 人物参与度 -->
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 30px;">
        <h2 style="color: #fff; font-size: 1.2em; margin-bottom: 25px;">人物参与事件数</h2>
        <div style="display: flex; flex-direction: column; gap: 15px;">
          {sortedPeople.map(([name, count]) => {
            const person = people.find(p => p.data.name === name);
            const color = person?.data.color || '#4ca1af';
            return (
              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                  <span style="color: rgba(255,255,255,0.8); font-size: 0.9em;">{name}</span>
                  <span style={`color: ${color}; font-size: 0.9em; font-weight: 600;`}>{count} 次</span>
                </div>
                <div style="height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden;">
                  <div style={`height: 100%; width: ${(count / maxPersonCount) * 100}%; background: ${color}; border-radius: 4px; transition: width 0.5s;`}></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 时间分布 -->
    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 30px; margin-bottom: 50px;">
      <h2 style="color: #fff; font-size: 1.2em; margin-bottom: 25px;">事件时间分布</h2>
      <div style="display: flex; align-items: flex-end; gap: 15px; height: 200px; padding-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1);">
        {sortedMonths.map(([month, count]) => (
          <div style="flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end;">
            <div style="color: #4ca1af; font-size: 0.85em; margin-bottom: 5px; font-weight: 600;">{count}</div>
            <div style={`width: 100%; background: linear-gradient(to top, #4ca1af, #4ca1af60); border-radius: 6px 6px 0 0; height: ${(count / maxMonthCount) * 150}px; min-height: 4px; transition: height 0.5s;`}></div>
          </div>
        ))}
      </div>
      <div style="display: flex; gap: 15px; margin-top: 10px;">
        {sortedMonths.map(([month]) => (
          <div style="flex: 1; text-align: center; color: rgba(255,255,255,0.5); font-size: 0.8em;">{month.substring(5)}</div>
        ))}
      </div>
    </div>

    <!-- 标签云 -->
    {sortedTags.length > 0 && (
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 30px;">
        <h2 style="color: #fff; font-size: 1.2em; margin-bottom: 25px;">分类标签</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 12px;">
          {sortedTags.map(([tag, count]) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: rgba(76,161,175,0.1); border: 1px solid rgba(76,161,175,0.2); border-radius: 20px; transition: all 0.3s;">
              <span style={`color: #fff; font-size: ${0.9 + count * 0.1}em;`}>#{tag}</span>
              <span style="background: rgba(76,161,175,0.3); color: #4ca1af; padding: 2px 8px; border-radius: 10px; font-size: 0.8em;">{count}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <style is:global>
    a[href^="/tags/"]:hover { background: rgba(76,161,175,0.2) !important; border-color: rgba(76,161,175,0.4) !important; }
    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: 1fr !important; }
      .stats-overview { grid-template-columns: repeat(2, 1fr) !important; }
    }
  </style>
</BaseLayout>
