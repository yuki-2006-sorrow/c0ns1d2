---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanetCanvas from '../components/PlanetCanvas.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events', ({ data }) => !data.draft);
const planetEvents = allEvents.map(e => ({
  slug: e.slug,
  title: e.data.title,
  date: e.data.date,
  persons: e.data.persons,
  color: e.data.color,
  size: e.data.size,
}));
---

<BaseLayout>
  <div style="position: relative;">
    <PlanetCanvas events={planetEvents} />
    <div style="position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.3); font-size: 0.85em; text-align: center; pointer-events: none; letter-spacing: 1px;">
      拖动画面 · 滚轮缩放 · 点击星球进入事件
    </div>
  </div>
</BaseLayout>
