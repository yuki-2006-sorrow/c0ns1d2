---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);
events.sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title="c0ns1d2">
  <div class="gallery-page">
    <!-- 电影开场：三段点击播放（静态帧 Ken Burns 运镜占位，视频齐了把对应 .shot 内换成 <video>） -->
    <div class="cinema" id="cinema">
      <div class="shots" id="shots">
        <div class="shot is-active"><img src="/intro/k1.png" alt="" draggable="false" /></div>
        <div class="shot"><img src="/intro/k2.png" alt="" draggable="false" /></div>
        <div class="shot"><img src="/intro/k3.png" alt="" draggable="false" /></div>
        <div class="shot"><img src="/intro/k4.png" alt="" draggable="false" /></div>
      </div>
      <div class="red-flash" id="redFlash"></div>
      <div class="cinema-vignette"></div>
      <div class="cinema-ui">
        <div class="c-brand">c0ns1d2 · 惊天魔盗团记忆库</div>
        <div class="c-hint" id="cHint">点击开始</div>
        <div class="c-dots" id="cDots"><span class="on"></span><span></span><span></span></div>
      </div>
    </div>

    <!-- 主区域 -->
    <div class="main-view" id="mainView">
      <!-- 卡片堆叠 -->
      <div class="cards-container" id="cardsContainer">
        {events.map((event, i) => (
          <div class="card" data-index={i}>
            <div class="card-img" style="background: #f0f0f0;"></div>
            <div class="card-shine"></div>
          </div>
        ))}
      </div>

      <!-- 文字堆叠 -->
      <div class="text-stack" id="textStack">
        {events.map((event, i) => (
          <div class="text-item" data-index={i}>
            <span class="text-date">{event.data.date}</span>
            <h2 class="text-title">{event.data.title}</h2>
            <p class="text-desc">{event.data.persons.join(' · ')}</p>
            <a href={`/events/${event.slug}`} class="text-enter">进入事件 →</a>
          </div>
        ))}
      </div>

      <!-- 底部控制 -->
      <div class="controls">
        <button class="ctrl-btn" id="prevBtn">←</button>
        <div class="counter">
          <span id="currentNum">01</span>
          <span class="counter-divider">/</span>
          <span id="totalNum">{String(events.length).padStart(2, '0')}</span>
        </div>
        <button class="ctrl-btn" id="nextBtn">→</button>
      </div>

      <!-- 进度条 -->
      <div class="progress-bar">
        <div class="progress-fill" id="progressFill"></div>
      </div>

      <!-- 顶部导航提示 -->
      <div class="top-hint">
        <span>滚动 / 点击 / 方向键 切换</span>
      </div>
    </div>
  </div>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; background: #0a0a0a; }

    .gallery-page { position: relative; height: 100vh; width: 100vw; overflow: hidden; }

    /* ===== 电影开场 ===== */
    .cinema {
      position: fixed; inset: 0; z-index: 100;
      background: #050607; overflow: hidden;
      cursor: pointer;
      transition: opacity 0.9s ease, visibility 0.9s ease;
    }
    .cinema.cinema-out { opacity: 0; visibility: hidden; pointer-events: none; }
    .shots { position: absolute; inset: 0; }
    .shot {
      position: absolute; inset: 0;
      opacity: 0; transition: opacity 1.1s ease;
      will-change: opacity;
    }
    .shot.is-active { opacity: 1; }
    .shot img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; -webkit-user-drag: none;
      transform: scale(1.08);
      will-change: transform;
    }
    .red-flash {
      position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 45%, #d11f2f 0%, #b01826 55%, #7d101c 100%);
      opacity: 0; transform: scale(0.4);
      will-change: transform, opacity; pointer-events: none;
    }
    .cinema-vignette {
      position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0) 45%, rgba(0,0,0,0.45) 100%);
    }
    .cinema-ui { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
    .c-brand {
      position: absolute; top: 6%; left: 50%;
      transform: translateX(-50%);
      font-size: clamp(0.8em, 1.6vw, 1.1em);
      letter-spacing: 0.5em; text-indent: 0.5em;
      color: rgba(255,255,255,0.55);
    }
    .c-hint {
      position: absolute; bottom: 7%; left: 50%;
      transform: translateX(-50%);
      font-size: 0.9em; letter-spacing: 0.5em; text-indent: 0.5em;
      color: rgba(255,255,255,0.85);
      animation: cHintPulse 2.2s ease-in-out infinite;
      transition: opacity 0.4s ease;
    }
    .c-hint.hide { opacity: 0; }
    @keyframes cHintPulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }
    .c-dots { position: absolute; bottom: 7.2%; right: 6%; display: flex; gap: 9px; }
    .c-dots span {
      width: 6px; height: 6px; border-radius: 50%;
      background: rgba(255,255,255,0.22);
      transition: background 0.4s ease, transform 0.4s ease;
    }
    .c-dots span.on { background: rgba(255,255,255,0.85); transform: scale(1.25); }

    /* 主视图 */
    .main-view {
      position: relative; height: 100vh; width: 100vw;
      opacity: 0; transition: opacity 1s ease 0.5s;
    }
    .main-view.visible { opacity: 1; }

    /* 卡片堆叠 */
    .cards-container {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -55%);
      width: 400px; height: 500px;
      perspective: 1200px;
    }
    .card {
      position: absolute;
      width: 100%; height: 100%;
      border-radius: 8px;
      overflow: hidden;
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .card-img {
      width: 100%; height: 100%;
      background: #f0f0f0;
    }
    .card-shine {
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%);
      pointer-events: none;
    }

    /* 文字堆叠 */
    .text-stack {
      position: absolute;
      bottom: 120px; left: 50%;
      transform: translateX(-50%);
      width: 600px; height: 180px;
      text-align: center;
    }
    .text-item {
      position: absolute;
      width: 100%;
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .text-date {
      font-size: 0.8em; color: rgba(255,255,255,0.4);
      letter-spacing: 0.3em; display: block; margin-bottom: 12px;
    }
    .text-title {
      font-size: clamp(1.5em, 3vw, 2.5em);
      font-weight: 300; color: #fff;
      margin-bottom: 10px; line-height: 1.3;
    }
    .text-desc {
      font-size: 0.9em; color: rgba(255,255,255,0.5);
      margin-bottom: 20px;
    }
    .text-enter {
      display: inline-block;
      color: rgba(255,255,255,0.7);
      font-size: 0.85em; letter-spacing: 0.1em;
      padding-bottom: 4px;
      border-bottom: 1px solid rgba(255,255,255,0.3);
      transition: all 0.3s;
    }
    .text-enter:hover {
      color: #fff; border-bottom-color: #fff;
    }

    /* 控制 */
    .controls {
      position: absolute;
      bottom: 40px; left: 50%;
      transform: translateX(-50%);
      display: flex; align-items: center; gap: 30px;
    }
    .ctrl-btn {
      width: 44px; height: 44px;
      border: 1px solid rgba(255,255,255,0.2);
      background: transparent;
      color: rgba(255,255,255,0.6);
      border-radius: 50%;
      cursor: pointer;
      font-size: 1em;
      transition: all 0.3s;
      display: flex; align-items: center; justify-content: center;
    }
    .ctrl-btn:hover {
      border-color: rgba(255,255,255,0.5);
      color: #fff;
    }
    .counter {
      font-size: 0.9em; color: rgba(255,255,255,0.5);
      letter-spacing: 0.1em; min-width: 60px; text-align: center;
    }
    .counter-divider { margin: 0 6px; color: rgba(255,255,255,0.3); }
    #currentNum { color: #fff; font-weight: 500; }

    /* 进度条 */
    .progress-bar {
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 2px;
      background: rgba(255,255,255,0.08);
    }
    .progress-fill {
      height: 100%;
      background: #fff;
      transition: width 0.5s ease;
    }

    .top-hint {
      position: absolute;
      top: 30px; left: 50%;
      transform: translateX(-50%);
      font-size: 0.75em; color: rgba(255,255,255,0.25);
      letter-spacing: 0.2em;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scrollAnim {
      0% { transform: scaleY(0); transform-origin: top; }
      50% { transform: scaleY(1); transform-origin: top; }
      51% { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    @media (max-width: 768px) {
      .cards-container { width: 280px; height: 360px; }
      .text-stack { width: 90%; bottom: 100px; }
      .text-title { font-size: 1.5em; }
    }
  </style>

  <script is:inline>
    const cards = document.querySelectorAll('.card');
    const textItems = document.querySelectorAll('.text-item');
    const total = cards.length;
    let current = 0;
    let isAnimating = false;

    const mainView = document.getElementById('mainView');
    const currentNum = document.getElementById('currentNum');
    const progressFill = document.getElementById('progressFill');

    /* ===== 电影开场：三段点击播放（静态帧 Ken Burns 运镜，视频齐了可换 video） ===== */
    let introScrolled = false;
    const cinema = document.getElementById('cinema');
    const cHint = document.getElementById('cHint');
    const redFlash = document.getElementById('redFlash');
    const cDots = document.querySelectorAll('#cDots span');
    const shotEls = document.querySelectorAll('.shot');
    const shotImgs = document.querySelectorAll('.shot img');

    // 每帧：停留基准 scale；推镜（scale + 平移%）；新帧淡入时的进入 scale
    const HOLD  = [1.08, 1.12, 1.16, 1.5];
    const PUSH  = [
      { s: 1.26, x: -2.5, y: 1.0 },
      { s: 1.28, x: 2.0,  y: 0 },
      { s: 1.42, x: 3.0,  y: 2.0 },
      { s: 2.7,  x: 0,    y: 0 },
    ];
    const ENTER = [null, 1.22, 1.26, 1.5];
    const SEG_MS = 4200;
    const EASE = 'cubic-bezier(0.22,0.8,0.3,1)';
    let seg = 0;          // 0=停K1 · 1=停K2 · 2=停K3 · 3=已转场
    let busy = false;
    let breatheAnim = null;

    const tf = (s, x, y) => `scale(${s}) translate(${x || 0}%, ${y || 0}%)`;
    function setShot(i) { shotEls.forEach((el, k) => el.classList.toggle('is-active', k === i)); }
    function stopBreathe() { if (breatheAnim) { breatheAnim.cancel(); breatheAnim = null; } }
    function breathe(i) {
      stopBreathe();
      const h = HOLD[i];
      breatheAnim = shotImgs[i].animate([
        { transform: tf(h, 0, 0) },
        { transform: tf(h + 0.015, 0.4, 0.3) },
        { transform: tf(h, 0, 0) },
      ], { duration: 5600, iterations: Infinity, easing: 'ease-in-out' });
    }

    function enterGallery() {
      if (introScrolled) return;
      introScrolled = true;
      stopBreathe();
      cinema.classList.add('cinema-out');
      mainView.classList.add('visible');
      setTimeout(() => updateView(), 700);
    }

    // 段一/段二：当前帧推镜 → 中段叠化到下一帧 → 停在呼吸帧
    function playSeg(a, b) {
      busy = true;
      cHint.classList.add('hide');
      const p = PUSH[a];
      shotImgs[a].animate(
        [{ transform: tf(HOLD[a], 0, 0) }, { transform: tf(p.s, p.x, p.y) }],
        { duration: SEG_MS, fill: 'forwards', easing: EASE });
      setTimeout(() => {
        setShot(b);
        shotImgs[b].animate(
          [{ transform: tf(ENTER[b], 0, 0) }, { transform: tf(HOLD[b], 0, 0) }],
          { duration: SEG_MS - 1200, fill: 'forwards', easing: EASE });
      }, 1500);
      setTimeout(() => {
        seg = b; busy = false;
        breathe(b);
        cDots[b].classList.add('on');
        cHint.textContent = '点击继续';
        cHint.classList.remove('hide');
      }, SEG_MS);
    }

    // 段三：K3 推近 → K4 徽章特写继续放大 → 红色铺满 → 进照片墙
    function playFinale() {
      busy = true;
      cHint.classList.add('hide');
      const p3 = PUSH[2];
      shotImgs[2].animate(
        [{ transform: tf(HOLD[2], 0, 0) }, { transform: tf(p3.s, p3.x, p3.y) }],
        { duration: 2600, fill: 'forwards', easing: EASE });
      setTimeout(() => {
        setShot(3);
        shotImgs[3].animate(
          [{ transform: tf(ENTER[3], 0, 0) }, { transform: tf(PUSH[3].s, 0, 0) }],
          { duration: 2600, fill: 'forwards', easing: EASE });
      }, 1300);
      setTimeout(() => {
        redFlash.style.transition = 'opacity 0.9s ease, transform 1.1s ease';
        redFlash.style.opacity = '1';
        redFlash.style.transform = 'scale(1.6)';
      }, 2400);
      setTimeout(enterGallery, 3700);
    }

    cinema.addEventListener('click', () => {
      if (busy || introScrolled) return;
      if (seg === 0) playSeg(0, 1);
      else if (seg === 1) playSeg(1, 2);
      else if (seg === 2) playFinale();
    });

    // 初始：K1 呼吸
    setShot(0);
    breathe(0);

    // 开场播放期间，滚轮/键盘/触摸均不直接进入照片墙（严格点击三段推进）
    window.addEventListener('wheel', (e) => { if (!introScrolled) e.preventDefault(); }, { passive: false });

    function updateView() {
      cards.forEach((card, i) => {
        const offset = i - current;
        const absOffset = Math.abs(offset);

        if (absOffset > 3) {
          card.style.opacity = '0';
          card.style.transform = `translateX(${offset * 100}px) scale(0.7)`;
          card.style.zIndex = 0;
          card.style.pointerEvents = 'none';
        } else {
          const x = offset * 180;
          const scale = 1 - absOffset * 0.12;
          const opacity = 1 - absOffset * 0.25;
          const rotateY = offset * -8;
          const zIndex = 10 - absOffset;

          card.style.opacity = opacity;
          card.style.transform = `translateX(${x}px) scale(${scale}) rotateY(${rotateY}deg)`;
          card.style.zIndex = zIndex;
          card.style.pointerEvents = absOffset === 0 ? 'auto' : 'auto';
        }
      });

      textItems.forEach((item, i) => {
        const offset = i - current;
        const absOffset = Math.abs(offset);

        if (absOffset > 2) {
          item.style.opacity = '0';
          item.style.transform = `translateY(${offset * 60}px)`;
          item.style.pointerEvents = 'none';
        } else {
          const y = offset * 50;
          const opacity = absOffset === 0 ? 1 : 0.3;
          const scale = absOffset === 0 ? 1 : 0.9;

          item.style.opacity = opacity;
          item.style.transform = `translateY(${y}px) scale(${scale})`;
          item.style.pointerEvents = absOffset === 0 ? 'auto' : 'none';
          item.style.filter = absOffset === 0 ? 'none' : 'blur(1px)';
        }
      });

      currentNum.textContent = String(current + 1).padStart(2, '0');
      progressFill.style.width = ((current + 1) / total * 100) + '%';
    }

    function goTo(index) {
      if (isAnimating) return;
      current = Math.max(0, Math.min(total - 1, index));
      isAnimating = true;
      updateView();
      setTimeout(() => isAnimating = false, 700);
    }

    // 滚轮切换
    let wheelTimeout;
    window.addEventListener('wheel', (e) => {
      if (!introScrolled) return;
      clearTimeout(wheelTimeout);
      wheelTimeout = setTimeout(() => {
        if (e.deltaY > 30) goTo(current + 1);
        else if (e.deltaY < -30) goTo(current - 1);
      }, 50);
    }, { passive: true });

    // 点击卡片切换
    cards.forEach((card, i) => {
      card.addEventListener('click', () => goTo(i));
    });

    // 按钮
    document.getElementById('prevBtn').addEventListener('click', () => goTo(current - 1));
    document.getElementById('nextBtn').addEventListener('click', () => goTo(current + 1));

    // 键盘
    document.addEventListener('keydown', (e) => {
      if (!introScrolled) {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); cinema.click(); }
        return;
      }
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') goTo(current + 1);
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') goTo(current - 1);
    });

    // 触摸
    let touchStartY = 0;
    window.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
    });
    window.addEventListener('touchend', (e) => {
      if (!introScrolled) return;
      const diff = touchStartY - e.changedTouches[0].clientY;
      if (Math.abs(diff) > 50) {
        goTo(diff > 0 ? current + 1 : current - 1);
      }
    });
  </script>
</BaseLayout>
