---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft && data.major);
events.sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title="c0ns1d2">
  <div class="gallery-page">
    <!-- 电影开场：三段点击播放（静态帧 Ken Burns 运镜占位，视频齐了把对应 .shot 内换成 <video>） -->
    <div class="cinema" id="cinema">
      <div class="shots" id="shots">
        <div class="shot is-active"><video class="sv" id="introVideo" src="/intro/intro.mp4" poster="/intro/k1.png" muted playsinline preload="auto" disablepictureinpicture></video></div>
      </div>
      <div class="red-flash" id="redFlash"></div>
      <div class="cinema-vignette"></div>
      <div class="cinema-ui">
        <div class="c-brand">c0ns1d2 · 惊天魔盗团记忆库</div>
        <button type="button" class="c-hint" id="cHint">点击开始</button>
        <div class="c-dots" id="cDots"><span class="on"></span><span></span><span></span></div>
      </div>
      <button type="button" id="introSkip" class="skip-intro">直接进入 →</button>
    </div>

    <!-- 主区域 -->
    <div class="main-view" id="mainView" inert>
      <nav class="archive-exits" aria-label="继续探索">
        <a href="/events">记忆</a><a href="/works">书·影·游戏</a><a href="/timeline">时间索引</a><button type="button" id="replayIntro">重看开场</button>
      </nav>
      <!-- 卡片堆叠 -->
      <div class="cards-container" id="cardsContainer">
        {events.map((event, i) => (
          <button type="button" class="card" data-index={i} aria-label={`查看 ${event.data.title}`}>
            <div class="card-img">
              {event.data.images[0] ? <img src={event.data.images[0]} alt={event.data.title} loading="lazy" /> : <span class="card-placeholder"><small>{event.data.date}</small>{event.data.title}</span>}
            </div>
            <div class="card-shine"></div>
          </button>
        ))}
      </div>

      <!-- 文字堆叠 -->
      <div class="text-stack" id="textStack">
        {events.map((event, i) => (
          <div class="text-item" data-index={i}>
            <span class="text-date">{event.data.date}</span>
            <h2 class="text-title">{event.data.title}</h2>
            <p class="text-desc">{event.data.persons.join(' · ')}</p>
            <a href={`/events/${event.slug.split('/').pop()}`} class="text-enter">进入事件 →</a>
          </div>
        ))}
      </div>

      <!-- 底部控制 -->
      <div class="controls">
        <button class="ctrl-btn" id="prevBtn" aria-label="上一段记忆">←</button>
        <div class="counter">
          <span id="currentNum" aria-live="polite">01</span>
          <span class="counter-divider">/</span>
          <span id="totalNum">{String(events.length).padStart(2, '0')}</span>
        </div>
        <button class="ctrl-btn" id="nextBtn" aria-label="下一段记忆">→</button>
      </div>

      <!-- 进度条 -->
      <div class="progress-bar">
        <div class="progress-fill" id="progressFill"></div>
      </div>

      <!-- 顶部导航提示 -->
      <div class="top-hint">
        <span>滚动 / 点击 / 方向键 切换</span>
      </div>
    </div>
  </div>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; background: #0a0a0a; }
    /* 首页沉浸式：隐藏固定导航栏（避免误点"首页"链接跳回），并去掉内容区顶部预留 */
    #siteNav { display: none; }
    .content { padding-top: 0; }

    .gallery-page { position: relative; height: 100vh; width: 100vw; overflow: hidden; }
    .archive-exits { position: absolute; top: 28px; left: 28px; display: flex; gap: 22px; z-index: 30; font-size: .8rem; color: #d4c2b2; }
    .archive-exits a { padding: 8px 0; }
    .archive-exits button { background: transparent; border: 0; color: inherit; font: inherit; padding: 8px 0; cursor: pointer; }
    .skip-intro { position: absolute; right: 24px; top: 24px; z-index: 8; background: #111b; color: #e1d3c7; border: 1px solid #ffffff35; padding: 10px 16px; cursor: pointer; font: inherit; }
    .cinema-ui .c-hint { border: 0; background: transparent; padding: 12px; font-family: inherit; pointer-events: auto; cursor: pointer; }
    .cinema-ui .c-hint.hide { pointer-events: none; }
    .ctrl-btn:disabled { opacity: .3; cursor: default; }
    .card { border: 0; padding: 0; background: #201b20; text-align: left; }
    @media(prefers-reduced-motion: reduce) { .card, .text-item, .main-view, .cinema { transition: none !important; } .c-hint { animation: none !important; } }
    @media(max-width: 768px) { .gallery-page, .main-view { height: 100dvh; } .archive-exits { gap: 14px; font-size: .75rem; } .cards-container { top: 30dvh !important; height: 32dvh !important; width: min(64vw, 260px) !important; } .text-stack { top: 55dvh !important; transform: translateX(-50%) !important; height: 25dvh; } .text-item { max-height: 100%; overflow-y: auto; } .text-desc { margin-bottom: 12px; } }
    .card-img img { width: 100%; height: 100%; object-fit: cover; }
    .card-placeholder { height: 100%; display: flex; flex-direction: column; justify-content: end; gap: 22px; padding: 36px; color: #d8c2ac; font-family: 'Songti SC', 'SimSun', serif; font-size: 1.8rem; line-height: 1.6; background: linear-gradient(145deg, #35262c, #151316); }
    .card-placeholder small { font: .75rem sans-serif; letter-spacing: .18em; color: #b6a197; }
    @media(max-width: 768px) { .archive-exits { top: 12px; left: 20px; gap: 20px; } .top-hint { display: none; } }

    /* ===== 电影开场 ===== */
    .cinema {
      position: fixed; inset: 0; z-index: 100;
      background: #050607; overflow: hidden;
      cursor: pointer;
      transition: opacity 0.9s ease, visibility 0.9s ease;
    }
    .cinema.cinema-out { opacity: 0; visibility: hidden; pointer-events: none; }
    .shots { position: absolute; inset: 0; }
    .shot {
      position: absolute; inset: 0;
      opacity: 0;
      background: #050607 url('/intro/k1.png') center / cover no-repeat;
    }
    .shot.is-active { opacity: 1; }
    /* 素材首尾帧已逐段对齐，只做最简单的淡入叠化，不做任何网页端推近/缩放 */
    .shot video.sv {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; -webkit-user-drag: none;
      background: #050607;
      opacity: 0;
    }
    .shot video.sv.is-ready { opacity: 1; }
    .red-flash {
      position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 45%, #9c2f35 0%, #7d252a 55%, #56171c 100%);
      opacity: 0;
      will-change: opacity; pointer-events: none;
    }
    .cinema-vignette {
      position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0) 45%, rgba(0,0,0,0.45) 100%);
    }
    .cinema-ui { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
    .c-brand {
      position: absolute; top: 6%; left: 50%;
      transform: translateX(-50%);
      font-size: clamp(0.8em, 1.6vw, 1.1em);
      letter-spacing: 0.5em; text-indent: 0.5em;
      color: rgba(255,255,255,0.55);
    }
    .c-hint {
      position: absolute; bottom: 7%; left: 50%;
      transform: translateX(-50%);
      font-size: 0.9em; letter-spacing: 0.5em; text-indent: 0.5em;
      color: rgba(255,255,255,0.85);
      animation: cHintPulse 2.2s ease-in-out infinite;
      transition: opacity 0.4s ease;
    }
    .c-hint.hide { opacity: 0; }
    @keyframes cHintPulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }
    .c-dots { position: absolute; bottom: 7.2%; right: 6%; display: flex; gap: 9px; }
    .c-dots span {
      width: 6px; height: 6px; border-radius: 50%;
      background: rgba(255,255,255,0.22);
      transition: background 0.4s ease, transform 0.4s ease;
    }
    .c-dots span.on { background: rgba(255,255,255,0.85); transform: scale(1.25); }

    /* 主视图 */
    .main-view {
      position: relative; height: 100vh; width: 100vw;
      opacity: 0; transition: opacity 1s ease 0.5s;
    }
    .main-view.visible { opacity: 1; }

    /* 卡片堆叠（左栏） */
    .cards-container {
      position: absolute;
      top: 50%; left: 30%;
      transform: translate(-50%, -50%);
      width: 380px; height: 500px;
      perspective: 1200px;
    }
    .card {
      position: absolute;
      width: 100%; height: 100%;
      border-radius: 8px;
      overflow: hidden;
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .card-img {
      width: 100%; height: 100%;
      background: #f0f0f0;
    }
    .card-shine {
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 50%);
      pointer-events: none;
    }

    /* 文字堆叠（右栏） */
    .text-stack {
      position: absolute;
      top: 50%; left: 73%;
      transform: translate(-50%, -50%);
      width: 380px;
      text-align: left;
    }
    .text-item {
      position: absolute;
      width: 100%;
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .text-date {
      font-size: 0.8em; color: rgba(255,255,255,0.4);
      letter-spacing: 0.3em; display: block; margin-bottom: 16px;
    }
    .text-title {
      font-size: clamp(1.4em, 2.2vw, 2em);
      font-weight: 300; color: #fff;
      margin-bottom: 18px; line-height: 1.35;
    }
    .text-desc {
      font-size: 0.95em; color: rgba(255,255,255,0.55);
      margin-bottom: 28px; line-height: 1.6;
    }
    .text-enter {
      display: inline-block;
      color: rgba(255,255,255,0.7);
      font-size: 0.85em; letter-spacing: 0.1em;
      padding-bottom: 4px;
      border-bottom: 1px solid rgba(255,255,255,0.3);
      transition: all 0.3s;
    }
    .text-enter:hover {
      color: #fff; border-bottom-color: #fff;
    }

    /* 控制 */
    .controls {
      position: absolute;
      bottom: 40px; left: 50%;
      transform: translateX(-50%);
      display: flex; align-items: center; gap: 30px;
    }
    .ctrl-btn {
      width: 44px; height: 44px;
      border: 1px solid rgba(255,255,255,0.2);
      background: transparent;
      color: rgba(255,255,255,0.6);
      border-radius: 50%;
      cursor: pointer;
      font-size: 1em;
      transition: all 0.3s;
      display: flex; align-items: center; justify-content: center;
    }
    .ctrl-btn:hover {
      border-color: rgba(255,255,255,0.5);
      color: #fff;
    }
    .counter {
      font-size: 0.9em; color: rgba(255,255,255,0.5);
      letter-spacing: 0.1em; min-width: 60px; text-align: center;
    }
    .counter-divider { margin: 0 6px; color: rgba(255,255,255,0.3); }
    #currentNum { color: #fff; font-weight: 500; }

    /* 进度条 */
    .progress-bar {
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 2px;
      background: rgba(255,255,255,0.08);
    }
    .progress-fill {
      height: 100%;
      background: #fff;
      transition: width 0.5s ease;
    }

    .top-hint {
      position: absolute;
      top: 30px; left: 50%;
      transform: translateX(-50%);
      font-size: 0.75em; color: rgba(255,255,255,0.25);
      letter-spacing: 0.2em;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scrollAnim {
      0% { transform: scaleY(0); transform-origin: top; }
      50% { transform: scaleY(1); transform-origin: top; }
      51% { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    @media (max-width: 768px) {
      .cards-container {
        width: 260px; height: 340px;
        top: 33%; left: 50%;
      }
      .text-stack {
        width: 86%;
        top: 70%; left: 50%;
        text-align: center;
      }
      .text-title { font-size: 1.4em; }
      .controls { gap: 18px; bottom: 28px; }
    }
  </style>

  <script>
    import { createIntroController } from '../scripts/intro-controller.js';
    const cards = document.querySelectorAll('.card');
    const textItems = document.querySelectorAll('.text-item');
    const total = cards.length;
    let current = 0;
    let isAnimating = false;

    const mainView = document.getElementById('mainView');
    const currentNum = document.getElementById('currentNum');
    const progressFill = document.getElementById('progressFill');

    /* ===== 保留单个开场视频及三段点击，只在初次准备和重看时定位 ===== */
    let introScrolled = false;
    const cinema = document.getElementById('cinema');
    const cHint = document.getElementById('cHint');
    const redFlash = document.getElementById('redFlash');
    const cDots = document.querySelectorAll('#cDots span');
    const v = document.getElementById('introVideo');

    const intro = createIntroController({ video: v, hint: cHint, dots: cDots, redFlash, onFinish: enterGallery });

    function enterGallery() {
      if (introScrolled) return;
      introScrolled = true;
      cinema.inert = true;
      mainView.inert = false;
      intro.stop();
      try { localStorage.setItem('introPlayed', '1'); } catch (e) {}
      cinema.classList.add('cinema-out');
      mainView.classList.add('visible');
      updateView();
    }

    cinema.addEventListener('click', () => { if (!introScrolled) intro.advance(); });
    document.getElementById('introSkip').addEventListener('click', event => { event.stopPropagation(); enterGallery(); document.getElementById('replayIntro').focus({ preventScroll: true }); });
    document.getElementById('replayIntro').addEventListener('click', () => {
      introScrolled = false;
      intro.reset();
      mainView.inert = true; cinema.inert = false;
      mainView.classList.remove('visible'); cinema.classList.remove('cinema-out');
      cHint.focus({ preventScroll: true });
    });

    // 初始：本次会话已看过开场则直接进照片墙；否则定格在 HEAD 等点击（不自动播放，避免启动抽搐）
    let alreadyPlayed = false;
    try { alreadyPlayed = localStorage.getItem('introPlayed') === '1'; } catch (e) {}
    if (alreadyPlayed) {
      introScrolled = true;
      cinema.inert = true;
      mainView.inert = false;
      v.pause();
      cinema.classList.add('cinema-out');
      mainView.classList.add('visible');
      updateView();
    } else {
      intro.reset();
    }

    // 开场播放期间，滚轮不直接进照片墙（严格点击推进）
    window.addEventListener('wheel', (e) => { if (!introScrolled && !e.ctrlKey && !e.metaKey) e.preventDefault(); }, { passive: false });

    function updateView() {
      if (!total) {
        document.getElementById('prevBtn').disabled = true;
        document.getElementById('nextBtn').disabled = true;
        currentNum.textContent = '00';
        progressFill.style.width = '0%';
        document.getElementById('textStack').textContent = '暂无已公开的精选记忆';
        return;
      }
      cards.forEach((card, i) => {
        card.tabIndex = i === current ? 0 : -1;
        const offset = i - current;
        const absOffset = Math.abs(offset);

        if (absOffset > 3) {
          card.style.opacity = '0';
          card.style.transform = `translate(${offset * 80}px, ${offset * 60}px) scale(0.7)`;
          card.style.zIndex = 0;
          card.style.pointerEvents = 'none';
        } else {
          // 斜向堆叠：后面的卡片沿对角线（右下）错开，露出边缘，填充空间
          const x = offset * 70;
          const y = offset * 46;
          const scale = 1 - absOffset * 0.1;
          const opacity = 1 - absOffset * 0.22;
          const rotateY = offset * -6;
          const zIndex = 10 - absOffset;

          card.style.opacity = opacity;
          card.style.transform = `translate(${x}px, ${y}px) scale(${scale}) rotateY(${rotateY}deg)`;
          card.style.zIndex = zIndex;
          card.style.pointerEvents = 'auto';
        }
      });

      textItems.forEach((item, i) => {
        item.inert = i !== current;
        item.setAttribute('aria-hidden', String(i !== current));
        const offset = i - current;
        const absOffset = Math.abs(offset);

        if (absOffset === 0) {
          item.style.opacity = '1';
          item.style.transform = 'translateY(0) scale(1)';
          item.style.pointerEvents = 'auto';
          item.style.filter = 'none';
        } else {
          // 非当前项直接隐藏（不做虚化残留），仅保留切换时的滑动过渡
          item.style.opacity = '0';
          item.style.transform = `translateY(${offset * 40}px) scale(0.96)`;
          item.style.pointerEvents = 'none';
          item.style.filter = 'none';
        }
      });

      currentNum.textContent = String(current + 1).padStart(2, '0');
      document.getElementById('prevBtn').disabled = current === 0;
      document.getElementById('nextBtn').disabled = current === total - 1;
      progressFill.style.width = ((current + 1) / total * 100) + '%';
    }

    let lastGoTime = -Infinity;
    function goTo(index) {
      if (!total) return false;
      const now = performance.now();
      if (now - lastGoTime < 100) return false;   // 短节流防同一手势瞬间翻多页，不阻塞连续翻页
      const target = Math.max(0, Math.min(total - 1, index));
      if (target === current) return false;
      current = target;
      lastGoTime = now;
      updateView();
      return true;
    }

    // 滚轮切换：累积滚动量，连续信号可连续翻页（transition 会平滑重定向），做到跟手丝滑
    let wheelAccum = 0;
    let wheelResetTimer = null;
    const STEP_DELTA = 90;
    window.addEventListener('wheel', (e) => {
      if (!introScrolled || e.ctrlKey || e.metaKey || e.target.closest('.archive-exits, .text-item')) return;
      wheelAccum += e.deltaY;
      clearTimeout(wheelResetTimer);
      wheelResetTimer = setTimeout(() => { wheelAccum = 0; }, 180);
      while (wheelAccum >= STEP_DELTA) {
        wheelAccum -= STEP_DELTA;
        if (!goTo(current + 1)) break;
      }
      while (wheelAccum <= -STEP_DELTA) {
        wheelAccum += STEP_DELTA;
        if (!goTo(current - 1)) break;
      }
    }, { passive: true });

    // 点击卡片切换
    cards.forEach((card, i) => {
      card.addEventListener('click', () => { if (i === current) location.assign(textItems[i].querySelector('a').href); else goTo(i); });
    });

    // 按钮
    document.getElementById('prevBtn').addEventListener('click', () => goTo(current - 1));
    document.getElementById('nextBtn').addEventListener('click', () => goTo(current + 1));

    // 键盘
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.target.closest('button, a, input, textarea, select')) return;
      if (!introScrolled) {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); cinema.click(); }
        return;
      }
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); goTo(current + 1); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); goTo(current - 1); }
    });

    // 触摸
    let touchStartY = 0;
    window.addEventListener('touchstart', (e) => {
      if (e.target.closest('.text-item, .archive-exits, .controls') || e.touches.length !== 1) { touchStartY = null; return; }
      touchStartY = e.touches[0].clientY;
    });
    window.addEventListener('touchend', (e) => {
      if (!introScrolled || touchStartY == null) return;
      const diff = touchStartY - e.changedTouches[0].clientY;
      if (Math.abs(diff) > 50) {
        goTo(diff > 0 ? current + 1 : current - 1);
      }
    });
  </script>
</BaseLayout>
