---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanetCanvas from '../components/PlanetCanvas.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events', ({ data }) => !data.draft);
const allPeople = await getCollection('people');
const allJournals = await getCollection('journal', ({ data }) => !data.draft);

const planetEvents = allEvents.map(e => ({
  slug: e.slug,
  title: e.data.title,
  date: e.data.date,
  persons: e.data.persons,
  color: e.data.color,
  size: e.data.size,
}));

// 收集所有标签
const allTags = new Set();
allEvents.forEach(e => e.data.tags.forEach(t => allTags.add(t)));
---

<BaseLayout>
  <div style="position: relative; height: calc(100vh - 80px);">
    <PlanetCanvas events={planetEvents} />

    <!-- 左上角统计面板 -->
    <div class="home-stats" style="position: absolute; top: 25px; left: 30px; background: rgba(10,14,23,0.75); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 20px 25px; z-index: 10;">
      <div style="color: #4ca1af; font-size: 0.8em; letter-spacing: 2px; margin-bottom: 12px;">惊天魔盗团 · 记忆库</div>
      <div style="display: flex; gap: 25px;">
        <div>
          <div style="color: #fff; font-size: 1.6em; font-weight: 600;">{allEvents.length}</div>
          <div style="color: rgba(255,255,255,0.5); font-size: 0.8em;">事件</div>
        </div>
        <div>
          <div style="color: #fff; font-size: 1.6em; font-weight: 600;">{allPeople.length}</div>
          <div style="color: rgba(255,255,255,0.5); font-size: 0.8em;">人物</div>
        </div>
        <div>
          <div style="color: #fff; font-size: 1.6em; font-weight: 600;">{allTags.size}</div>
          <div style="color: rgba(255,255,255,0.5); font-size: 0.8em;">分类</div>
        </div>
      </div>
    </div>

    <!-- 右上角快速入口 -->
    <div class="home-entries" style="position: absolute; top: 25px; right: 30px; display: flex; flex-direction: column; gap: 10px; z-index: 10;">
      <a href="/timeline" style="padding: 10px 18px; background: rgba(10,14,23,0.75); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: rgba(255,255,255,0.8); font-size: 0.9em; transition: all 0.3s; text-align: center;">📅 时间线</a>
      <a href="/tags" style="padding: 10px 18px; background: rgba(10,14,23,0.75); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: rgba(255,255,255,0.8); font-size: 0.9em; transition: all 0.3s; text-align: center;">🏷️ 分类</a>
      <a href="/stats" style="padding: 10px 18px; background: rgba(10,14,23,0.75); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: rgba(255,255,255,0.8); font-size: 0.9em; transition: all 0.3s; text-align: center;">📊 统计</a>
      <a href="/search" style="padding: 10px 18px; background: rgba(10,14,23,0.75); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: rgba(255,255,255,0.8); font-size: 0.9em; transition: all 0.3s; text-align: center;">🔍 搜索</a>
    </div>

    <!-- 底部提示 -->
    <div style="position: absolute; bottom: 25px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.3); font-size: 0.85em; text-align: center; pointer-events: none; letter-spacing: 1px;">
      拖动画面 · 滚轮缩放 · 点击星球进入事件
    </div>
  </div>

  <style is:global>
    .home-entry a:hover { background: rgba(76,161,175,0.2) !important; border-color: rgba(76,161,175,0.4) !important; color: #fff !important; }
    @media (max-width: 768px) {
      .home-stats { padding: 12px 16px !important; top: 15px !important; left: 15px !important; }
      .home-stats > div > div:first-child { font-size: 1.2em !important; }
      .home-stats > div { gap: 15px !important; }
      .home-entries { top: auto !important; bottom: 60px !important; right: 15px !important; left: 15px !important; flex-direction: row !important; flex-wrap: wrap !important; justify-content: center !important; }
      .home-entries a { padding: 8px 14px !important; font-size: 0.82em !important; }
    }
  </style>
</BaseLayout>
