---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>c0ns1d2</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%234ca1af'/></svg>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      overflow: hidden;
      background: #efece5;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
      user-select: none;
      width: 100%; height: 100%;
    }
</style>
</head>
<body>
  <div id="scene-wrap">
    <div id="scene">
      <!-- 立绘1：靠墙（开场） -->
      <div id="char-idle" class="character">
        <img src="/intro/haruhi-idle.jpg" alt="" draggable="false" />
      </div>

      <!-- 立绘2：叉腰近景 -->
      <div id="char-closeup" class="character">
        <img src="/intro/haruhi-closeup.jpg" alt="" draggable="false" />
      </div>

      <!-- 飘带（卡片路径） -->
      <div id="ribbon"></div>
      <!-- 卡片容器 -->
      <div id="cards-container"></div>
    </div>

    <!-- 前景暗角 -->
    <div class="vignette"></div>
    <!-- 扫光 -->
    <div class="light-sweep" id="sweep"></div>
  </div>

  <div id="ui-layer">
    <div id="brand">c0ns1d2</div>
    <div id="hint">点击画面</div>
    <div id="stage-indicator"></div>
  </div>

  <style>
    #scene-wrap {
      position: fixed; inset: 0;
      perspective: 1600px;
      perspective-origin: 50% 42%;
      overflow: hidden;
      background: linear-gradient(180deg, #f4f1ea 0%, #e8e4db 100%);
    }

    #scene {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      will-change: transform;
    }

    .character {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-style: preserve-3d;
      backface-visibility: hidden;
    }
    .character img {
      height: 92vh;
      max-width: 92vw;
      object-fit: contain;
      -webkit-user-drag: none;
      filter: drop-shadow(0 20px 40px rgba(60,50,40,0.18));
    }
    #char-closeup img {
      height: 100vh;
      max-width: 100vw;
      filter: drop-shadow(0 24px 50px rgba(60,50,40,0.15));
    }

    #char-idle {
      transform: translateZ(0);
      animation: idleBreathe 5s ease-in-out infinite;
    }
    @keyframes idleBreathe {
      0%, 100% { transform: translateZ(0) scale(1); }
      50%      { transform: translateZ(20px) scale(1.006); }
    }

    #char-closeup {
      opacity: 0;
      transform: translateZ(60px) scale(1.02);
      pointer-events: none;
    }
    #char-closeup.visible {
      animation: closeupBreathe 4.5s ease-in-out infinite;
    }
    @keyframes closeupBreathe {
      0%, 100% { transform: translateZ(60px) scale(1.02); }
      50%      { transform: translateZ(60px) scale(1.026) translateY(-0.3%); }
    }

    /* 飘带 */
    #ribbon {
      position: absolute;
      left: 50%; top: 52%;
      height: 10px;
      width: 0;
      border-radius: 6px;
      opacity: 0;
      background: linear-gradient(90deg,
        rgba(200,35,35,0) 0%,
        #c82323 8%,
        #e84545 50%,
        #c82323 92%,
        rgba(200,35,35,0) 100%);
      box-shadow: 0 4px 24px rgba(200,35,35,0.35);
      transform-origin: 0 50%;
      z-index: 20;
    }

    /* 卡片 */
    .memory-card {
      position: absolute;
      left: 50%; top: 50%;
      width: 190px; height: 255px;
      margin-left: -95px; margin-top: -127px;
      border-radius: 12px;
      background: linear-gradient(160deg, #2a3240 0%, #181d26 100%);
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: 0 18px 50px rgba(30,30,40,0.45);
      opacity: 0;
      z-index: 30;
      overflow: hidden;
    }
    .memory-card::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent 40%);
    }

    /* 暗角 */
    .vignette {
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 10;
      background: radial-gradient(ellipse at center,
        transparent 55%,
        rgba(80,70,60,0.10) 85%,
        rgba(60,50,40,0.18) 100%);
    }

    /* 扫光 */
    .light-sweep {
      position: fixed; inset: 0;
      z-index: 40;
      pointer-events: none;
      opacity: 0;
      background: radial-gradient(circle at 50% 45%, rgba(255,255,255,0.9), rgba(255,255,255,0.4) 40%, transparent 70%);
    }
    .light-sweep.flash { animation: sweep 0.7s ease; }
    @keyframes sweep {
      0% { opacity: 0; }
      40% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* 运动模糊 */
    .motion-blur { filter: blur(6px) brightness(1.2); }

    /* UI */
    #ui-layer {
      position: fixed; inset: 0;
      z-index: 100;
      pointer-events: none;
      display: flex; flex-direction: column;
      align-items: center; justify-content: flex-end;
      padding-bottom: 7vh;
      gap: 14px;
    }
    #brand {
      position: absolute;
      top: 5vh; left: 50%;
      transform: translateX(-50%);
      font-size: 1.3em;
      letter-spacing: 0.5em;
      color: rgba(70,60,50,0.55);
      font-weight: 300;
    }
    #hint {
      color: rgba(70,60,50,0.6);
      font-size: 0.85em;
      letter-spacing: 0.35em;
      animation: pulse 2.2s infinite;
    }
    #stage-indicator {
      color: rgba(70,60,50,0.35);
      font-size: 0.72em;
      letter-spacing: 0.15em;
      height: 1em;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.35; }
      50% { opacity: 0.9; }
    }

    /* 淡出转场到主界面 */
    #fade-out {
      position: fixed; inset: 0;
      z-index: 200;
      background: #0a0a0a;
      opacity: 0;
      pointer-events: none;
      transition: opacity 1s ease;
    }
    #fade-out.show { opacity: 1; }

    @media (max-width: 768px) {
      .character img { height: 80vh; }
      .memory-card { width: 140px; height: 190px; margin-left: -70px; margin-top: -95px; }
    }
  </style>

  <div id="fade-out"></div>

  <script>
    const STAGES = { IDLE: 0, ROTATING: 1, CLOSEUP: 2, RIBBON: 3, CARDS: 4, DONE: 5 };
    let stage = STAGES.IDLE;
    let locked = false;

    const wrap = document.getElementById('scene-wrap');
    const scene = document.getElementById('scene');
    const charIdle = document.getElementById('char-idle');
    const charCloseup = document.getElementById('char-closeup');
    const hint = document.getElementById('hint');
    const indicator = document.getElementById('stage-indicator');
    const sweep = document.getElementById('sweep');
    const fadeOut = document.getElementById('fade-out');

    function easeInOut(t) { return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2; }
    function lerp(a, b, t) { return a + (b - a) * t; }

    wrap.addEventListener('click', () => {
      if (locked) return;
      if (stage === STAGES.IDLE) startRotation();
      else if (stage === STAGES.CLOSEUP) startRibbon();
      else if (stage === STAGES.CARDS || stage === STAGES.DONE) enterSite();
    });

    // 阶段1：环绕 + 立绘切换
    function startRotation() {
      locked = true;
      stage = STAGES.ROTATING;
      hint.style.opacity = '0';
      indicator.textContent = '';
      charIdle.style.animation = 'none';

      const duration = 2600;
      const start = performance.now();
      let switched = false;

      function frame(now) {
        const t = Math.min((now - start) / duration, 1);
        const e = easeInOut(t);

        // 完整360度旋转 + 轻微推近
        const angle = e * 360;
        const zoom = 1 + e * 0.04;
        scene.style.transform = `rotateY(${angle}deg) scale(${zoom})`;

        // 中段运动模糊 + 切换立绘
        const distToSide = Math.abs(Math.sin(angle * Math.PI / 180));
        if (distToSide < 0.35) {
          charIdle.classList.add('motion-blur');
          charCloseup.classList.add('motion-blur');
        } else {
          charIdle.classList.remove('motion-blur');
          charCloseup.classList.remove('motion-blur');
        }

        if (t > 0.42 && t < 0.58) {
          if (!switched) {
            switched = true;
            charIdle.style.opacity = '0';
            charCloseup.style.opacity = '1';
            charCloseup.classList.add('visible');
            sweep.classList.add('flash');
            setTimeout(() => sweep.classList.remove('flash'), 700);
          }
        } else if (t <= 0.42) {
          charIdle.style.opacity = (1 - t / 0.42 * 0.3).toString();
        }

        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          scene.style.transition = 'none';
          scene.style.transform = 'rotateY(0deg) scale(1.02)';
          charIdle.classList.remove('motion-blur');
          charCloseup.classList.remove('motion-blur');
          void scene.offsetWidth;
          scene.style.transition = '';
          stage = STAGES.CLOSEUP;
          locked = false;
          indicator.textContent = '';
          hint.textContent = '再次点击';
          hint.style.opacity = '1';
        }
      }
      requestAnimationFrame(frame);
    }

    // 阶段2：SOS臂章展开成飘带
    function startRibbon() {
      locked = true;
      stage = STAGES.RIBBON;
      hint.style.opacity = '0';

      const ribbon = document.getElementById('ribbon');
      const maxW = Math.min(window.innerWidth * 0.82, 920);
      ribbon.style.opacity = '1';

      const duration = 1300;
      const start = performance.now();

      function frame(now) {
        const t = Math.min((now - start) / duration, 1);
        const e = easeInOut(t);
        const w = maxW * e;
        const wave = Math.sin(t * Math.PI) * 14;
        ribbon.style.width = w + 'px';
        ribbon.style.transform = `translate(-${w/2}px, -50%) rotateZ(${-4 + wave*0.2}deg)`;
        if (t < 1) requestAnimationFrame(frame);
        else {
          // 持续飘动
          ribbon.style.animation = 'ribbonWave 2.8s ease-in-out infinite';
          injectKeyframes(maxW);
          launchCards();
        }
      }
      requestAnimationFrame(frame);
    }

    function injectKeyframes(maxW) {
      const s = document.createElement('style');
      s.textContent = `@keyframes ribbonWave {
        0%,100% { transform: translate(-${maxW/2}px,-50%) rotateZ(-3deg) translateY(0); }
        25% { transform: translate(-${maxW/2}px,-50%) rotateZ(1deg) translateY(-6px); }
        50% { transform: translate(-${maxW/2}px,-50%) rotateZ(2deg) translateY(2px); }
        75% { transform: translate(-${maxW/2}px,-50%) rotateZ(-1deg) translateY(-4px); }
      }`;
      document.head.appendChild(s);
    }

    // 阶段3：卡牌沿飘带飞入
    function launchCards() {
      stage = STAGES.CARDS;
      const container = document.getElementById('cards-container');
      const maxW = Math.min(window.innerWidth * 0.82, 920);
      const count = 5;

      for (let i = 0; i < count; i++) {
        const card = document.createElement('div');
        card.className = 'memory-card';
        container.appendChild(card);
        const delay = i * 220;
        setTimeout(() => {
          const finalX = (i - (count - 1) / 2) * 34;
          const finalY = (i % 2 === 0 ? -1 : 1) * 12;
          const finalRot = (i - 2) * 4;
          card.animate([
            { opacity: 0, transform: `translate(${-maxW/2}px, 30px) rotate(-12deg) scale(0.4)` },
            { opacity: 1, offset: 0.35, transform: `translate(${-maxW/4}px, -40px) rotate(4deg) scale(0.85)` },
            { opacity: 1, offset: 0.7, transform: `translate(${finalX*0.5}px, 10px) rotate(${finalRot*0.5}deg) scale(1.02)` },
            { opacity: 1, transform: `translate(${finalX}px, ${finalY}px) rotate(${finalRot}deg) scale(1)` },
          ], { duration: 1300, easing: 'cubic-bezier(0.4,0,0.2,1)', fill: 'forwards' });
        }, delay);
      }

      setTimeout(() => {
        stage = STAGES.DONE;
        locked = false;
        hint.textContent = '点击进入记忆库';
        hint.style.opacity = '1';
      }, count * 220 + 1500);
    }

    function enterSite() {
      locked = true;
      fadeOut.classList.add('show');
      setTimeout(() => { window.location.href = '/'; }, 1000);
    }

    // 调试：URL hash 直接进入某阶段（#closeup / #ribbon / #cards）
    const debugStage = location.hash.replace('#', '');
    if (debugStage === 'closeup') {
      scene.style.transition = 'none';
      scene.style.transform = 'rotateY(0deg) scale(1.02)';
      charIdle.style.opacity = '0';
      charIdle.style.animation = 'none';
      charCloseup.style.opacity = '1';
      charCloseup.classList.add('visible');
      stage = STAGES.CLOSEUP;
    }
  </script>
</body>
</html>
