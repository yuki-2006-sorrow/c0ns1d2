---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);

// 收集所有标签并统计
const tagMap = new Map<string, number>();
for (const e of events) {
  for (const tag of e.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="分类">
  <div style="max-width: 900px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="font-size: 2em; margin-bottom: 10px; color: #fff;">全部分类</h1>
    <p style="color: rgba(255,255,255,0.5); margin-bottom: 40px;">
      {tags.length} 个分类 · {events.length} 个事件
    </p>

    {tags.length === 0 ? (
      <div style="text-align: center; padding: 80px 20px; color: rgba(255,255,255,0.3);">
        <div style="font-size: 3em; margin-bottom: 20px;">🏷️</div>
        <p>还没有分类标签</p>
        <p style="font-size: 0.9em; margin-top: 10px;">在事件的 Markdown frontmatter 里添加 tags 字段即可</p>
        <pre style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; margin-top: 20px; text-align: left; font-size: 0.85em; color: rgba(255,255,255,0.6); overflow-x: auto;">---
title: 事件标题
date: 2026-01-01
persons: [朱浩宇]
tags: [聚餐, 高三]
---</pre>
      </div>
    ) : (
      <div style="display: flex; flex-wrap: wrap; gap: 12px;">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${encodeURIComponent(tag)}`} style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 30px; transition: all 0.3s;">
            <span style="color: #fff; font-size: 1.05em;">{tag}</span>
            <span style="background: rgba(76,161,175,0.2); color: #4ca1af; padding: 2px 10px; border-radius: 10px; font-size: 0.8em;">{count}</span>
          </a>
        ))}
      </div>
    )}
  </div>
  <style is:global>
    a[href^="/tags/"]:hover { background: rgba(76,161,175,0.1) !important; border-color: rgba(76,161,175,0.3) !important; transform: translateY(-2px); }
  </style>
</BaseLayout>
