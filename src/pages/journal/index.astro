---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const journals = await getCollection('journal', ({ data }) => !data.draft);
journals.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="随笔">
  <div style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="font-size: 2em; margin-bottom: 10px; color: #fff;">随笔 · 日记</h1>
    <p style="color: rgba(255,255,255,0.5); margin-bottom: 40px;">共 {journals.length} 篇</p>

    {journals.length === 0 ? (
      <div style="text-align: center; padding: 80px 20px; color: rgba(255,255,255,0.3);">
        <div style="font-size: 3em; margin-bottom: 20px;">✍️</div>
        <p>还没有随笔，把你的日记放到 src/content/journal/ 目录下吧</p>
      </div>
    ) : (
      <div style="display: flex; flex-direction: column; gap: 2px;">
        {journals.map(j => (
          <a href={`/journal/${j.slug}`} style="display: block; padding: 24px; border-radius: 12px; transition: background 0.3s;">
            <div style="color: rgba(255,255,255,0.4); font-size: 0.85em; margin-bottom: 6px;">{j.data.date} · {j.data.author}</div>
            <h3 style="color: #fff; font-size: 1.15em; margin-bottom: 8px;">{j.data.title}</h3>
            {j.data.tags.length > 0 && (
              <div style="display: flex; gap: 6px;">
                {j.data.tags.map(tag => (
                  <span style="color: rgba(255,255,255,0.4); font-size: 0.8em;">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
  <style is:global>
    a[href^="/journal/"]:hover { background: rgba(255,255,255,0.04) !important; }
  </style>
</BaseLayout>
