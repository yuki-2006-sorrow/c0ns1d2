---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { contentPreview } from '../../lib/content-preview.mjs';
const events = await getCollection('events', ({ data }) => !data.draft);
events.sort((first, second) => second.data.date.localeCompare(first.data.date));
const years = [...new Set(events.map(event => /^\d{4}/.test(event.data.date) ? event.data.date.slice(0,4) : '时间未定'))];
---
<BaseLayout title="记忆">
  <section class="memory-index">
    <header><p class="archive-eyebrow">那些留了下来的片刻</p><h1>记忆</h1><p class="index-intro">从一件小事开始，慢慢想起别的。</p><nav class="memory-views" aria-label="记忆浏览方式"><a href="/events" aria-current="page">列表</a><a href="/timeline">绳子时间线</a></nav></header>
    {events.length === 0 && <p class="index-intro">暂时还没有公开的记忆。</p>}
    {years.map(year => <section class="memory-year"><h2>{year}</h2><div>
      {events.filter(event => (/^\d{4}/.test(event.data.date) ? event.data.date.slice(0,4) : '时间未定') === year).map(event =>
        <a class:list={['memory-row', {'with-image': event.data.images.length > 0}]} href={`/events/${encodeURIComponent(event.slug.split('/').pop()!)}`}>
          {event.data.images[0] && <img src={event.data.images[0]} alt="" loading="lazy" />}
          <div><span class="memory-date">{event.data.date}</span><h3>{event.data.title}</h3>{contentPreview(event.data.summary, event.body) && <p>{contentPreview(event.data.summary, event.body)}</p>}<span class="memory-people">{event.data.persons.join(' · ')}</span></div>
          <span class="memory-arrow" aria-hidden="true">↗</span>
        </a>)}
    </div></section>)}
  </section>
  <style>
    .memory-index { max-width: 1000px; margin: auto; padding: 55px 26px 90px; }
    header { margin-bottom: 58px; }
    h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; margin-bottom: 20px; }
    .index-intro { color: var(--archive-muted); line-height: 1.9; }
    .memory-year { display: grid; grid-template-columns: 90px minmax(0,1fr); gap: 32px; margin-bottom: 40px; }
    .memory-year > h2 { color: #baaaa0; font-size: 1rem; font-weight: 400; padding-top: 22px; }
    .memory-row { display: grid; grid-template-columns: minmax(0,1fr) 20px; gap: 24px; padding: 24px 0; border-top: 1px solid var(--archive-line); align-items: start; }
    .memory-row.with-image { grid-template-columns: 120px minmax(0,1fr) 20px; }
    .memory-row img { width: 120px; aspect-ratio: 4/3; object-fit: cover; }
    .memory-date, .memory-people { font-size: .75rem; color: var(--archive-muted); line-height: 1.9; }
    h3 { font-family: var(--archive-serif); font-size: 1.45rem; line-height: 1.6; font-weight: 400; margin: 8px 0 12px; }
    .memory-row p { color: #b7aaa1; font-size: .9rem; line-height: 1.9; margin-bottom: 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .memory-row:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
    .memory-arrow { color: #bd9991; padding-top: 7px; }
    @media(max-width: 600px) { .memory-year { grid-template-columns: 1fr; gap: 4px; } .memory-row.with-image { grid-template-columns: minmax(0,1fr) 20px; } .memory-row img { display: none; } header { margin-bottom: 32px; } }
  </style>
</BaseLayout>
