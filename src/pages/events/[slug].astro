---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import Associations from '../../components/Associations.astro';
import ThoughtCapture from '../../components/ThoughtCapture.astro';
import { eventReference } from '../../lib/associations.mjs';
export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map(event => ({params:{slug:event.slug.split('/').pop()},props:{event}}));
}
const { event } = Astro.props;
const { Content } = await render(event);
---
<BaseLayout title={event.data.title}>
  <article class="reading-page">
    <header class="reading-header">
      <a href="/events" class="reading-back">← 记忆</a>
      <p class="archive-eyebrow">{event.data.date}</p>
      <h1>{event.data.title}</h1>
      <details class="reading-meta"><summary>这段记忆里的人与线索</summary><div>{event.data.persons.join(' · ')}</div>{event.data.tags.length > 0 && <div>{event.data.tags.map(tag => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}　</a>)}</div>}</details>
      <ThoughtCapture type="event" id={eventReference(event)} />
    </header>
    <div class="reading-layout">
      <div class="reading-main">
        {event.data.summary && <p class="reading-summary">{event.data.summary}</p>}
        <div class="reading-prose"><Content /></div>
        {event.data.quotes.length > 0 && <details class="reading-meta"><summary>原话与片段（{event.data.quotes.length}）</summary><div class="reading-prose">{event.data.quotes.map(quote => <blockquote>{quote}</blockquote>)}</div></details>}
        {event.data.images.length > 0 && <section class="reading-media"><h2>留下的照片</h2><div class="reading-media-grid">{event.data.images.map((image,index) => <button type="button" class="gallery-trigger" aria-label={`查看照片 ${index + 1}`}><img src={image} alt={`${event.data.title} · 照片 ${index + 1}`} class="gallery-img" loading="lazy" /></button>)}</div></section>}
        {event.data.videos.length > 0 && <section class="reading-media"><h2>影像</h2>{event.data.videos.map(video => <video controls preload="metadata" src={video} style="width:100%"></video>)}</section>}
        <footer class="reading-footer"><a href="/events">← 回到记忆</a><a href="/timeline">在时间里找一找 ↗</a></footer>
      </div>
      <div class="reading-rail"><Associations type="event" id={eventReference(event)} /></div>
    </div>
  </article>
  <dialog id="lightbox" aria-label="事件照片">
    <button type="button" id="lightbox-close" class="lightbox-control" aria-label="关闭照片">×</button>
    <button type="button" id="lightbox-prev" class="lightbox-control" aria-label="上一张照片">←</button>
    <img id="lightbox-img" alt="事件照片" />
    <button type="button" id="lightbox-next" class="lightbox-control" aria-label="下一张照片">→</button>
    <div id="lightbox-counter" role="status" aria-live="polite"></div>
    <div id="lightbox-error" role="status"></div>
  </dialog>
  <script>import '../../scripts/lightbox';</script>


  <style is:global>
    .gallery-trigger { border: 0; padding: 0; background: transparent; cursor: pointer; }
    .gallery-img { display: block; width: 100%; border-radius: 8px; }
    #lightbox { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 65px 60px; border: 0; background: #08080af5; color: #eee; }
    #lightbox[open] { display: grid; place-items: center; }
    #lightbox-img { max-width: 100%; max-height: calc(100dvh - 150px); object-fit: contain; }
    .lightbox-control { position: absolute; min-width: 44px; height: 44px; border: 1px solid #ffffff40; background: #18181d; color: #eee; font-size: 1.4rem; cursor: pointer; border-radius: 4px; }
    .lightbox-control:disabled { opacity: .25; cursor: default; }
    #lightbox-close { right: 18px; top: 16px; }
    #lightbox-prev { left: 8px; top: calc(50% - 22px); }
    #lightbox-next { right: 8px; top: calc(50% - 22px); }
    #lightbox-counter { position: absolute; bottom: 28px; text-align: center; left: 0; right: 0; }
    #lightbox-error { position: absolute; bottom: 60px; text-align: center; left: 60px; right: 60px; font-size: .85rem; }

  </style>
</BaseLayout>
