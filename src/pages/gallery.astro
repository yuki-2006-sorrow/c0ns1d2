---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);
events.sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title="照片墙">
  <div class="gallery-container">
    <!-- 开场屏 -->
    <section class="gallery-section intro-section">
      <div class="intro-content">
        <h1 class="intro-title">c0ns1d2</h1>
        <p class="intro-subtitle">惊天魔盗团 · 记忆库</p>
        <p class="intro-hint">向下滚动 ↓</p>
      </div>
    </section>

    <!-- 事件屏 -->
    {events.map((event, index) => (
      <section class="gallery-section event-section" data-index={index}>
        <div class="event-bg" style="background: {event.data.color}20;"></div>
        <div class="event-content">
          <div class="event-date">{event.data.date}</div>
          <h2 class="event-title">{event.data.title}</h2>
          <div class="event-persons">
            {event.data.persons.map(p => (
              <span class="person-tag">{p}</span>
            ))}
          </div>
          <a href={`/events/${event.slug}`} class="event-enter">
            进入事件 →
          </a>
        </div>
        <div class="event-number">{String(index + 1).padStart(2, '0')}</div>
      </section>
    ))}

    <!-- 结尾屏 -->
    <section class="gallery-section end-section">
      <div class="end-content">
        <h2>继续探索</h2>
        <div class="end-links">
          <a href="/timeline">时间线</a>
          <a href="/events">全部事件</a>
          <a href="/people">人物</a>
          <a href="/stats">统计</a>
        </div>
      </div>
    </section>
  </div>

  <!-- 进度指示器 -->
  <div class="progress-indicator">
    {events.map((_, i) => (
      <div class="progress-dot" data-target={i + 1}></div>
    ))}
  </div>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { overflow-x: hidden; }

    .gallery-container {
      scroll-snap-type: y mandatory;
      overflow-y: scroll;
      height: 100vh;
      scroll-behavior: smooth;
    }

    .gallery-section {
      height: 100vh;
      scroll-snap-align: start;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* 开场屏 */
    .intro-section {
      background: linear-gradient(135deg, #0a0e17 0%, #1a1f2e 100%);
    }
    .intro-content {
      text-align: center;
      opacity: 0;
      transform: translateY(30px);
      animation: fadeInUp 1.2s ease forwards;
    }
    .intro-title {
      font-size: 5em;
      font-weight: 700;
      color: #fff;
      letter-spacing: 8px;
      margin-bottom: 20px;
    }
    .intro-subtitle {
      font-size: 1.3em;
      color: rgba(255,255,255,0.6);
      letter-spacing: 4px;
      margin-bottom: 60px;
    }
    .intro-hint {
      font-size: 0.9em;
      color: rgba(255,255,255,0.3);
      animation: bounce 2s infinite;
    }

    /* 事件屏 */
    .event-section {
      background: #0a0e17;
    }
    .event-bg {
      position: absolute;
      inset: 0;
      opacity: 0.3;
      transition: transform 0.8s ease;
    }
    .event-section.is-visible .event-bg {
      transform: scale(1.05);
    }
    .event-content {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 0 40px;
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.8s ease;
    }
    .event-section.is-visible .event-content {
      opacity: 1;
      transform: translateY(0);
    }
    .event-date {
      font-size: 0.95em;
      color: rgba(255,255,255,0.5);
      letter-spacing: 3px;
      margin-bottom: 20px;
    }
    .event-title {
      font-size: 3em;
      color: #fff;
      font-weight: 600;
      margin-bottom: 25px;
      line-height: 1.3;
    }
    .event-persons {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }
    .person-tag {
      background: rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.7);
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.85em;
    }
    .event-enter {
      display: inline-block;
      padding: 14px 36px;
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 30px;
      color: #fff;
      font-size: 0.95em;
      transition: all 0.3s;
    }
    .event-enter:hover {
      background: #fff;
      color: #0a0e17;
    }
    .event-number {
      position: absolute;
      bottom: 40px;
      right: 50px;
      font-size: 8em;
      font-weight: 700;
      color: rgba(255,255,255,0.05);
      z-index: 1;
    }

    /* 结尾屏 */
    .end-section {
      background: linear-gradient(135deg, #1a1f2e 0%, #0a0e17 100%);
    }
    .end-content {
      text-align: center;
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s ease;
    }
    .end-section.is-visible .end-content {
      opacity: 1;
      transform: translateY(0);
    }
    .end-content h2 {
      font-size: 2.5em;
      color: #fff;
      margin-bottom: 40px;
    }
    .end-links {
      display: flex;
      gap: 20px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .end-links a {
      padding: 12px 28px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 25px;
      color: rgba(255,255,255,0.8);
      transition: all 0.3s;
    }
    .end-links a:hover {
      background: rgba(255,255,255,0.1);
      color: #fff;
    }

    /* 进度指示器 */
    .progress-indicator {
      position: fixed;
      right: 30px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 12px;
      z-index: 100;
    }
    .progress-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      cursor: pointer;
      transition: all 0.3s;
    }
    .progress-dot.active {
      background: #4ca1af;
      transform: scale(1.5);
    }

    @keyframes fadeInUp {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(10px); }
    }

    @media (max-width: 768px) {
      .intro-title { font-size: 3em; }
      .event-title { font-size: 2em; }
      .event-number { font-size: 4em; right: 20px; }
      .progress-indicator { right: 15px; }
    }
  </style>

  <script is:inline>
    const sections = document.querySelectorAll('.gallery-section');
    const dots = document.querySelectorAll('.progress-dot');
    const container = document.querySelector('.gallery-container');

    // Intersection Observer 触发动画
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          const index = Array.from(sections).indexOf(entry.target);
          dots.forEach((d, i) => d.classList.toggle('active', i === index - 1));
        }
      });
    }, { threshold: 0.5 });

    sections.forEach(s => observer.observe(s));

    // 点击进度点跳转
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        sections[i + 1].scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
</BaseLayout>
