---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events', ({ data }) => !data.draft);
events.sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title="照片墙">
  <div class="gallery-wrapper">
    <!-- 开场屏 -->
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <h1 class="hero-title">c0ns1d2</h1>
        <p class="hero-sub">惊天魔盗团 · 记忆库</p>
      </div>
      <div class="scroll-hint">
        <span></span>
        <p>SCROLL</p>
      </div>
    </section>

    <!-- 事件列表 -->
    {events.map((event, index) => (
      <section class="event-block" data-index={index}>
        <div class="event-image">
          <!-- 白色占位图，后续替换为真实照片 -->
          <div class="placeholder-img" style="background: #f5f5f5;"></div>
        </div>
        <div class="event-text">
          <span class="event-index">{String(index + 1).padStart(2, '0')}</span>
          <h2 class="event-title">{event.data.title}</h2>
          <a href={`/events/${event.slug}`} class="event-link">
            <span>查看</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>
    ))}

    <!-- 结尾 -->
    <section class="outro">
      <p>继续探索</p>
      <div class="outro-links">
        <a href="/timeline">时间线</a>
        <a href="/events">全部事件</a>
        <a href="/people">人物</a>
        <a href="/stats">统计</a>
      </div>
    </section>
  </div>

  <!-- 固定进度 -->
  <div class="side-progress">
    <span class="progress-label">01 / {String(events.length).padStart(2, '0')}</span>
    <div class="progress-line">
      <div class="progress-fill"></div>
    </div>
  </div>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0a0a0a; color: #fff; overflow-x: hidden; }

    .gallery-wrapper { position: relative; }

    /* 开场 */
    .hero {
      height: 100vh;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, #1a1a1a 0%, #0a0a0a 70%);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
    }
    .hero-title {
      font-size: clamp(3em, 10vw, 8em);
      font-weight: 200;
      letter-spacing: 0.2em;
      color: #fff;
      opacity: 0;
      animation: heroFade 2s ease 0.3s forwards;
    }
    .hero-sub {
      font-size: clamp(0.8em, 1.5vw, 1.1em);
      color: rgba(255,255,255,0.4);
      letter-spacing: 0.5em;
      margin-top: 20px;
      opacity: 0;
      animation: heroFade 2s ease 0.8s forwards;
    }
    .scroll-hint {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      opacity: 0;
      animation: heroFade 2s ease 1.5s forwards;
    }
    .scroll-hint span {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
      animation: scrollLine 2s infinite;
    }
    .scroll-hint p {
      font-size: 0.7em;
      letter-spacing: 0.3em;
      color: rgba(255,255,255,0.3);
    }

    /* 事件块 */
    .event-block {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 80px 10vw;
      gap: 60px;
      position: relative;
    }
    .event-block:nth-child(even) {
      flex-direction: row-reverse;
    }
    .event-image {
      flex: 1;
      position: relative;
      overflow: hidden;
      aspect-ratio: 4/3;
    }
    .placeholder-img {
      width: 100%;
      height: 100%;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .event-block.is-visible .placeholder-img {
      transform: scale(1);
    }
    .event-block:not(.is-visible) .placeholder-img {
      transform: scale(1.1);
    }
    .event-image::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(0,0,0,0.1), transparent);
      pointer-events: none;
    }
    .event-text {
      flex: 1;
      opacity: 0;
      transform: translateY(40px);
      transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .event-block.is-visible .event-text {
      opacity: 1;
      transform: translateY(0);
    }
    .event-index {
      font-size: 0.8em;
      color: rgba(255,255,255,0.3);
      letter-spacing: 0.3em;
      display: block;
      margin-bottom: 20px;
    }
    .event-title {
      font-size: clamp(1.8em, 4vw, 3.2em);
      font-weight: 300;
      line-height: 1.3;
      color: #fff;
      margin-bottom: 30px;
    }
    .event-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: rgba(255,255,255,0.6);
      font-size: 0.9em;
      letter-spacing: 0.1em;
      transition: all 0.3s;
      padding-bottom: 5px;
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }
    .event-link:hover {
      color: #fff;
      border-bottom-color: #fff;
      gap: 15px;
    }

    /* 结尾 */
    .outro {
      height: 60vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 40px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .outro p {
      font-size: 1.5em;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.2em;
    }
    .outro-links {
      display: flex;
      gap: 30px;
    }
    .outro-links a {
      color: rgba(255,255,255,0.5);
      font-size: 0.9em;
      letter-spacing: 0.1em;
      transition: color 0.3s;
    }
    .outro-links a:hover { color: #fff; }

    /* 侧边进度 */
    .side-progress {
      position: fixed;
      right: 40px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      z-index: 50;
    }
    .progress-label {
      font-size: 0.75em;
      color: rgba(255,255,255,0.4);
      letter-spacing: 0.1em;
      writing-mode: vertical-rl;
    }
    .progress-line {
      width: 1px;
      height: 120px;
      background: rgba(255,255,255,0.1);
      position: relative;
    }
    .progress-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: #fff;
      transition: height 0.3s;
    }

    @keyframes heroFade {
      to { opacity: 1; }
    }
    @keyframes scrollLine {
      0% { transform: scaleY(0); transform-origin: top; }
      50% { transform: scaleY(1); transform-origin: top; }
      51% { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    @media (max-width: 768px) {
      .event-block {
        flex-direction: column !important;
        padding: 60px 20px;
        gap: 30px;
      }
      .event-image { width: 100%; }
      .side-progress { display: none; }
    }
  </style>

  <script is:inline>
    const blocks = document.querySelectorAll('.event-block');
    const progressFill = document.querySelector('.progress-fill');
    const progressLabel = document.querySelector('.progress-label');
    const total = blocks.length;

    // 进入视口动画
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.2 });
    blocks.forEach(b => observer.observe(b));

    // 滚动进度 + 视差
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = Math.min(scrollY / docHeight, 1);

          progressFill.style.height = (progress * 100) + '%';

          // 当前事件序号
          let current = 1;
          blocks.forEach((block, i) => {
            const rect = block.getBoundingClientRect();
            if (rect.top < window.innerHeight * 0.5) current = i + 1;
          });
          progressLabel.textContent = String(current).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');

          // 图片视差
          blocks.forEach(block => {
            const rect = block.getBoundingClientRect();
            const img = block.querySelector('.placeholder-img');
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              const offset = (rect.top - window.innerHeight / 2) * 0.05;
              img.style.transform = `translateY(${offset}px) scale(1.05)`;
            }
          });

          ticking = false;
        });
        ticking = true;
      }
    });
  </script>
</BaseLayout>
