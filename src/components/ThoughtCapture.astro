---
const { type, id } = Astro.props;
---
<div class="thought-capture" data-type={type} data-entry={id}>
  <button type="button" class="archive-button capture-open" hidden>记下想到的</button>
  <dialog class="capture-dialog" aria-label="记下此刻想到的">
    <form class="capture-form">
      <header><div><p class="archive-eyebrow">从这里想到的</p><h2>先写下来</h2></div><button type="button" class="capture-close archive-button">收起</button></header>
      <label for="capture-title">标题（可以以后再想）</label><input id="capture-title" name="title" maxlength="300" placeholder="也可以没有标题">
      <label for="capture-body">此刻想到的</label><textarea id="capture-body" name="body" rows="14" maxlength="100000" placeholder="一句话，或者很长的一段。想到哪里，写到哪里。"></textarea>
      <details class="capture-reference"><summary>关联到其他记忆或作品（可选）</summary><label for="capture-search">找一条记录</label><input id="capture-search" type="search" placeholder="按名称筛选"><label for="capture-target">关联条目</label><select id="capture-target"><option value="">暂时不关联</option></select></details>
      <footer><button type="submit" class="archive-button archive-button-primary">存为草稿</button><span class="capture-status" role="status" aria-live="polite"></span></footer>
    </form>
  </dialog>
</div>
<script>import '../scripts/thought-capture.js';</script>
<style>
  .thought-capture { margin-top: 24px; }
  .capture-dialog { color: var(--archive-ink); background: var(--archive-bg); width: min(600px, 100%); height: 100dvh; max-height: none; max-width: 100%; margin: 0 0 0 auto; border: 0; border-left: 1px solid var(--archive-line); padding: 0; }
  .capture-dialog::backdrop { background: #0009; }
  .capture-form { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .capture-form header { display: flex; align-items: start; justify-content: space-between; gap: 20px; margin-bottom: 12px; }
  .capture-form h2 { font-weight: 400; font-size: 1.8rem; }
  .capture-form label { color: var(--archive-muted); font-size: .85rem; }
  .capture-form input, .capture-form textarea, .capture-form select { color: var(--archive-ink); background: var(--archive-surface); border: 1px solid var(--archive-line); border-radius: 3px; padding: 12px; font: inherit; width: 100%; }
  .capture-form textarea { resize: vertical; min-height: 38dvh; line-height: 1.9; }
  .capture-reference { padding: 16px 0; border-top: 1px solid var(--archive-line); }
  .capture-reference summary { cursor: pointer; color: var(--archive-muted); margin-bottom: 14px; }
  .capture-reference label { display: block; margin: 12px 0 8px; }
  .capture-form footer { position: sticky; bottom: 0; background: var(--archive-bg); padding: 14px 0; display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .capture-status { color: var(--archive-muted); font-size: .85rem; line-height: 1.8; }
  .capture-status a { color: var(--archive-ink); text-decoration: underline; }
  [hidden] { display: none !important; }
  @media(max-width: 560px) { .capture-form { padding: 22px 18px; } }
</style>
