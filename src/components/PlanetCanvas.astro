---
export interface PlanetEvent {
  slug: string;
  title: string;
  date: string;
  persons: string[];
  color: string;
  size: number;
}
const { events } = Astro.props as { events: PlanetEvent[] };
const eventsJson = JSON.stringify(events);
---

<canvas id="planet-canvas"></canvas>
<script type="application/json" id="planet-events-data">{eventsJson}</script>

<style>
  canvas { display: block; width: 100%; height: calc(100vh - 80px); cursor: grab; }
  canvas:active { cursor: grabbing; }
</style>

<script>
const events = JSON.parse(document.getElementById('planet-events-data').textContent);

const canvas = document.getElementById('planet-canvas');
const ctx = canvas.getContext('2d');
let W, H;
function resize() {
  W = canvas.width = canvas.offsetWidth * window.devicePixelRatio;
  H = canvas.height = canvas.offsetHeight * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
}
resize();
window.addEventListener('resize', resize);

// 星球纹理生成
function mulberry32(a) {
  return function() {
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  }
}

function createPlanetTexture(color, seed) {
  const size = 256;
  const c = document.createElement('canvas');
  c.width = size; c.height = size;
  const ctx2 = c.getContext('2d');
  ctx2.fillStyle = color;
  ctx2.fillRect(0, 0, size, size);
  const r = parseInt(color.slice(1,3), 16);
  const g = parseInt(color.slice(3,5), 16);
  const b = parseInt(color.slice(5,7), 16);
  const rand = mulberry32(seed);
  for (let i = 0; i < 80; i++) {
    const x = rand() * size, y = rand() * size;
    const radius = 10 + rand() * 50;
    const brightness = (rand() - 0.5) * 60;
    const grad = ctx2.createRadialGradient(x, y, 0, x, y, radius);
    const nr = Math.max(0, Math.min(255, r + brightness));
    const ng = Math.max(0, Math.min(255, g + brightness));
    const nb = Math.max(0, Math.min(255, b + brightness));
    grad.addColorStop(0, `rgba(${nr},${ng},${nb},0.6)`);
    grad.addColorStop(1, `rgba(${nr},${ng},${nb},0)`);
    ctx2.fillStyle = grad;
    ctx2.beginPath(); ctx2.arc(x, y, radius, 0, Math.PI*2); ctx2.fill();
  }
  for (let i = 0; i < 200; i++) {
    const x = rand() * size, y = rand() * size;
    const radius = 1 + rand() * 4;
    const brightness = (rand() - 0.5) * 40;
    ctx2.fillStyle = `rgba(${Math.max(0,Math.min(255,r+brightness))},${Math.max(0,Math.min(255,g+brightness))},${Math.max(0,Math.min(255,b+brightness))},0.4)`;
    ctx2.beginPath(); ctx2.arc(x, y, radius, 0, Math.PI*2); ctx2.fill();
  }
  return c;
}

// 背景星星
const stars = [];
for (let i = 0; i < 300; i++) {
  stars.push({ x: Math.random()*3000-1500, y: Math.random()*2000-1000, r: Math.random()*1.5+0.3, a: Math.random()*0.8+0.2 });
}

// 星球状态
const planets = events.map((e, i) => ({
  ...e,
  x: Math.cos(i * 0.5) * (100 + i * 35),
  y: Math.sin(i * 0.5) * (100 + i * 35),
  targetX: 0, targetY: 0,
  angle: Math.random() * Math.PI * 2,
  orbitRadius: 0, orbitSpeed: 0,
  orbiting: false,
  texture: createPlanetTexture(e.color, i * 1000 + 7)
}));

// 关系（共同人物）
function getRelations() {
  const rels = [];
  for (let i = 0; i < events.length; i++) {
    for (let j = i+1; j < events.length; j++) {
      const common = events[i].persons.filter(p => events[j].persons.includes(p));
      if (common.length > 0) rels.push({ a: i, b: j, weight: common.length });
    }
  }
  return rels;
}
const relations = getRelations();

// 相机
let camX = 0, camY = 0, camScale = 1;
let isDragging = false, dragStartX, dragStartY, camStartX, camStartY;
let selectedPlanet = null, hoverPlanet = null;
let mouseDownX = 0, mouseDownY = 0;

canvas.addEventListener('mousedown', (e) => {
  isDragging = true;
  dragStartX = e.clientX; dragStartY = e.clientY;
  mouseDownX = e.clientX; mouseDownY = e.clientY;
  camStartX = camX; camStartY = camY;
});
canvas.addEventListener('mousemove', (e) => {
  if (isDragging) {
    camX = camStartX + (e.clientX - dragStartX) / camScale;
    camY = camStartY + (e.clientY - dragStartY) / camScale;
  }
  const rect = canvas.getBoundingClientRect();
  const mx = (e.clientX - rect.left - rect.width/2) / camScale - camX;
  const my = (e.clientY - rect.top - rect.height/2) / camScale - camY;
  hoverPlanet = null;
  for (const p of planets) {
    if (Math.hypot(p.x - mx, p.y - my) < p.size + 10) { hoverPlanet = p; break; }
  }
  canvas.style.cursor = hoverPlanet ? 'pointer' : (isDragging ? 'grabbing' : 'grab');
});
canvas.addEventListener('mouseup', (e) => {
  const moved = Math.abs(e.clientX - mouseDownX) > 5 || Math.abs(e.clientY - mouseDownY) > 5;
  if (!moved && hoverPlanet) {
    window.location.href = `/events/${hoverPlanet.slug}`;
  }
  isDragging = false;
});
canvas.addEventListener('wheel', (e) => {
  e.preventDefault();
  camScale = Math.max(0.3, Math.min(3, camScale * (e.deltaY > 0 ? 0.9 : 1.1)));
}, { passive: false });

// 触摸
let touchStartX, touchStartY;
canvas.addEventListener('touchstart', (e) => {
  if (e.touches.length === 1) {
    isDragging = true;
    touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY;
    camStartX = camX; camStartY = camY;
  }
});
canvas.addEventListener('touchmove', (e) => {
  if (isDragging && e.touches.length === 1) {
    camX = camStartX + (e.touches[0].clientX - touchStartX) / camScale;
    camY = camStartY + (e.touches[0].clientY - touchStartY) / camScale;
  }
});
canvas.addEventListener('touchend', () => { isDragging = false; });

// 动画
let time = 0;
function animate() {
  time += 0.016;
  ctx.fillStyle = '#0a0e17';
  ctx.fillRect(0, 0, W, H);
  ctx.save();
  const rect = canvas.getBoundingClientRect();
  ctx.translate(rect.width/2, rect.height/2);
  ctx.scale(camScale, camScale);
  ctx.translate(camX, camY);

  for (const s of stars) {
    const twinkle = Math.sin(time * 2 + s.x) * 0.3 + 0.7;
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
    ctx.fillStyle = `rgba(255,255,255,${s.a * twinkle})`;
    ctx.fill();
  }

  // 关系线
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  for (const r of relations) {
    if (r.weight >= 2) {
      ctx.beginPath();
      ctx.moveTo(planets[r.a].x, planets[r.a].y);
      ctx.lineTo(planets[r.b].x, planets[r.b].y);
      ctx.stroke();
    }
  }

  for (const p of planets) {
    if (p.orbiting && selectedPlanet) {
      p.angle += p.orbitSpeed;
      p.x = selectedPlanet.x + Math.cos(p.angle) * p.orbitRadius;
      p.y = selectedPlanet.y + Math.sin(p.angle) * p.orbitRadius;
    } else if (p.targetX !== undefined) {
      p.x += (p.targetX - p.x) * 0.03;
      p.y += (p.targetY - p.y) * 0.03;
    }

    // 光晕
    const isHover = hoverPlanet && hoverPlanet.slug === p.slug;
    const glowSize = isHover ? p.size * 1.8 : p.size * 1.3;
    const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowSize);
    gradient.addColorStop(0, p.color + '80');
    gradient.addColorStop(1, p.color + '00');
    ctx.beginPath(); ctx.arc(p.x, p.y, glowSize, 0, Math.PI*2);
    ctx.fillStyle = gradient; ctx.fill();

    // 星球纹理
    ctx.save();
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI*2); ctx.clip();
    const offsetX = (time * 8) % 256;
    ctx.drawImage(p.texture, p.x - p.size - offsetX, p.y - p.size, p.size*2, p.size*2);
    ctx.drawImage(p.texture, p.x - p.size - offsetX + 256, p.y - p.size, p.size*2, p.size*2);
    const lightGrad = ctx.createRadialGradient(p.x - p.size*0.4, p.y - p.size*0.4, 0, p.x, p.y, p.size*1.2);
    lightGrad.addColorStop(0, 'rgba(255,255,255,0.25)');
    lightGrad.addColorStop(0.5, 'rgba(255,255,255,0)');
    lightGrad.addColorStop(1, 'rgba(0,0,0,0.5)');
    ctx.fillStyle = lightGrad;
    ctx.fillRect(p.x - p.size, p.y - p.size, p.size*2, p.size*2);
    ctx.restore();

    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1; ctx.stroke();
  }

  ctx.restore();
  requestAnimationFrame(animate);
}
animate();
</script>
